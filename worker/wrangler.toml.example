name = "trading-companion-webhook"
main = "src/index.mjs"
compatibility_date = "2026-07-30"

[vars]
ALLOWED_ORIGINS = "https://rync2709.github.io"
RETENTION_DAYS = "30"

[[d1_databases]]
binding = "DB"
database_name = "trading-companion-alerts"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "migrations"

[secrets]
required = [
  "TRADINGVIEW_WEBHOOK_TOKEN",
  "SYNC_API_TOKEN"
]
