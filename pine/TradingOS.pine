color bullishColor = color.rgb(82, 212, 147)
color bearishColor = color.rgb(239, 105, 118)
color neutralColor = color.rgb(142, 151, 154)
color warningColor = color.rgb(237, 189, 91)
color panelColor = color.rgb(18, 23, 24)
color panelBorderColor = color.rgb(55, 64, 66)
color textColor = color.rgb(238, 242, 241)
color mutedTextColor = color.rgb(161, 170, 172)

f_structure_state(int length) =>
    float pivotHigh = ta.pivothigh(high, length, length)
    float pivotLow = ta.pivotlow(low, length, length)
    var float latestHigh = na
    var float previousHigh = na
    var float latestLow = na
    var float previousLow = na

    if not na(pivotHigh)
        previousHigh := latestHigh
        latestHigh := pivotHigh

    if not na(pivotLow)
        previousLow := latestLow
        latestLow := pivotLow

    bool hasStructure = (
        not na(latestHigh) and
        not na(previousHigh) and
        not na(latestLow) and
        not na(previousLow)
    )
    bool bullishStructure = (
        hasStructure and
        latestHigh > previousHigh and
        latestLow > previousLow
    )
    bool bearishStructure = (
        hasStructure and
        latestHigh < previousHigh and
        latestLow < previousLow
    )

    bullishStructure ? 1 : bearishStructure ? -1 : 0

f_state_text(int state) =>
    state == 1 ? "BULLISH" : state == -1 ? "BEARISH" : "NEUTRAL"

f_state_short(int state) =>
    state == 1 ? "BULL" : state == -1 ? "BEAR" : "NEUTRAL"

f_state_color(int state) =>
    state == 1 ? bullishColor : state == -1 ? bearishColor : neutralColor

f_fvg_status_text(int status) =>
    status == 1 ? "FRESH" :
     status == 2 ? "PARTIAL" :
     status == 3 ? "FILLED" :
     "NONE"

f_fvg_state() =>
    var float bullishTop = na
    var float bullishBottom = na
    var int bullishStart = na
    var int bullishStatus = 0
    var float bearishTop = na
    var float bearishBottom = na
    var int bearishStart = na
    var int bearishStatus = 0

    // Every expression uses completed HTF bars. Bar [1] is the latest
    // completed candle and bar [3] is the first candle in the FVG pattern.
    bool bullishCreated = low[1] > high[3]
    bool bearishCreated = high[1] < low[3]

    if bullishCreated
        bullishTop := low[1]
        bullishBottom := high[3]
        bullishStart := time[3]
        bullishStatus := 1
    else if bullishStatus == 1 or bullishStatus == 2
        if low[1] <= bullishBottom
            bullishStatus := 3
        else if low[1] < bullishTop
            bullishStatus := 2

    if bearishCreated
        bearishTop := low[3]
        bearishBottom := high[1]
        bearishStart := time[3]
        bearishStatus := 1
    else if bearishStatus == 1 or bearishStatus == 2
        if high[1] >= bearishTop
            bearishStatus := 3
        else if high[1] > bearishBottom
            bearishStatus := 2

    [bullishTop, bullishBottom, bullishStart, bullishStatus, bearishTop, bearishBottom, bearishStart, bearishStatus]

f_fvg_active(int status) =>
    status == 1 or status == 2

f_ob_status_text(int status) =>
    status == 1 ? "FRESH" :
     status == 2 ? "MITIGATED" :
     status == 3 ? "INVALID" :
     "NONE"

f_ob_active(int status) =>
    status == 1 or status == 2

f_ob_state(
    int breakLookback,
    int searchCandles,
    int bodyLength,
    int atrLength,
    float minimumBodyMultiple,
    float minimumRangeAtr,
    float minimumBodyShare
) =>
    var float bullishTop = na
    var float bullishBottom = na
    var int bullishStart = na
    var int bullishStatus = 0
    var float bearishTop = na
    var float bearishBottom = na
    var int bearishStart = na
    var int bearishStatus = 0

    float completedBody = math.abs(close[1] - open[1])
    float completedRange = high[1] - low[1]
    float completedBodyShare = (
        completedRange > 0.0 ?
        completedBody / completedRange :
        0.0
    )
    float averageBodyBaseline = ta.sma(
        math.abs(close - open),
        bodyLength
    )[2]
    float atrBaseline = ta.atr(atrLength)[2]
    float priorHigh = ta.highest(high[2], breakLookback)
    float priorLow = ta.lowest(low[2], breakLookback)
    bool baselineReady = (
        not na(averageBodyBaseline) and
        averageBodyBaseline > 0.0 and
        not na(atrBaseline) and
        atrBaseline > 0.0 and
        not na(priorHigh) and
        not na(priorLow)
    )
    bool bullishDeparture = (
        baselineReady and
        close[1] > open[1] and
        close[1] > priorHigh and
        completedBody >= averageBodyBaseline * minimumBodyMultiple and
        completedRange >= atrBaseline * minimumRangeAtr and
        completedBodyShare >= minimumBodyShare
    )
    bool bearishDeparture = (
        baselineReady and
        close[1] < open[1] and
        close[1] < priorLow and
        completedBody >= averageBodyBaseline * minimumBodyMultiple and
        completedRange >= atrBaseline * minimumRangeAtr and
        completedBodyShare >= minimumBodyShare
    )

    float bullishCandidateTop = na
    float bullishCandidateBottom = na
    int bullishCandidateStart = na
    float bearishCandidateTop = na
    float bearishCandidateBottom = na
    int bearishCandidateStart = na

    if bullishDeparture
        for offset = 2 to searchCandles + 1
            if na(bullishCandidateStart) and close[offset] < open[offset]
                bullishCandidateTop := high[offset]
                bullishCandidateBottom := low[offset]
                bullishCandidateStart := time[offset]

    if bearishDeparture
        for offset = 2 to searchCandles + 1
            if na(bearishCandidateStart) and close[offset] > open[offset]
                bearishCandidateTop := high[offset]
                bearishCandidateBottom := low[offset]
                bearishCandidateStart := time[offset]

    bool bullishCreated = not na(bullishCandidateStart)
    bool bearishCreated = not na(bearishCandidateStart)

    if bullishCreated
        bullishTop := bullishCandidateTop
        bullishBottom := bullishCandidateBottom
        bullishStart := bullishCandidateStart
        bullishStatus := 1
    else if f_ob_active(bullishStatus)
        if close[1] < bullishBottom
            bullishStatus := 3
        else if low[1] <= bullishTop
            bullishStatus := 2

    if bearishCreated
        bearishTop := bearishCandidateTop
        bearishBottom := bearishCandidateBottom
        bearishStart := bearishCandidateStart
        bearishStatus := 1
    else if f_ob_active(bearishStatus)
        if close[1] > bearishTop
            bearishStatus := 3
        else if high[1] >= bearishBottom
            bearishStatus := 2

    [bullishTop, bullishBottom, bullishStart, bullishStatus, bearishTop, bearishBottom, bearishStart, bearishStatus]

f_structure_event_text(int eventCode) =>
    eventCode == 1 ? "BOS" :
     eventCode == 2 ? "CHOCH" :
     eventCode == 3 ? "MSS" :
     "WAIT"

f_quality_text(int quality) =>
    quality == 3 ? "STRONG" :
     quality == 2 ? "MEDIUM" :
     quality == 1 ? "WEAK" :
     "WAIT"

f_append_alert_event(string currentEvents, string nextEvent) =>
    currentEvents == "" ? nextEvent : currentEvents + " | " + nextEvent

f_execution_structure(int length, bool recentPdhSweep, bool recentPdlSweep) =>
    float pivotHigh = ta.pivothigh(high, length, length)
    float pivotLow = ta.pivotlow(low, length, length)
    var float latestSwingHigh = na
    var float latestSwingLow = na
    var int latestSwingHighBar = na
    var int latestSwingLowBar = na
    var bool latestHighBroken = false
    var bool latestLowBroken = false
    var int trendState = 0
    var int latestEvent = 0
    var int latestDirection = 0
    var float latestBreakLevel = na
    var int latestEventBar = na
    var int latestBreakOriginBar = na

    bool bullishBreak = (
        barstate.isconfirmed and
        not latestHighBroken and
        not na(latestSwingHigh) and
        close > latestSwingHigh and
        close[1] <= latestSwingHigh
    )
    bool bearishBreak = (
        barstate.isconfirmed and
        not latestLowBroken and
        not na(latestSwingLow) and
        close < latestSwingLow and
        close[1] >= latestSwingLow
    )
    int eventPulse = 0

    if bullishBreak
        eventPulse := trendState == -1 ? (recentPdlSweep ? 3 : 2) : 1
        latestEvent := eventPulse
        latestDirection := 1
        latestBreakLevel := latestSwingHigh
        latestEventBar := bar_index
        latestBreakOriginBar := latestSwingHighBar
        trendState := 1
        latestHighBroken := true
    else if bearishBreak
        eventPulse := trendState == 1 ? (recentPdhSweep ? 3 : 2) : 1
        latestEvent := eventPulse
        latestDirection := -1
        latestBreakLevel := latestSwingLow
        latestEventBar := bar_index
        latestBreakOriginBar := latestSwingLowBar
        trendState := -1
        latestLowBroken := true

    if not na(pivotHigh)
        latestSwingHigh := pivotHigh
        latestSwingHighBar := bar_index - length
        latestHighBroken := false

    if not na(pivotLow)
        latestSwingLow := pivotLow
        latestSwingLowBar := bar_index - length
        latestLowBroken := false

    [eventPulse, latestEvent, latestDirection, trendState, latestBreakLevel, latestEventBar, latestBreakOriginBar, latestSwingHigh, latestSwingLow, latestSwingHighBar, latestSwingLowBar, latestHighBroken, latestLowBroken]

f_cisd_state(
    int minimumDeliveryCandles,
    int maximumDeliveryCandles,
    int atrLength,
    float minimumLegAtr,
    int confirmationBars
) =>
    int requiredCandles = math.min(minimumDeliveryCandles, maximumDeliveryCandles)
    float atrValue = ta.atr(atrLength)
    float rollingHigh = ta.highest(high, maximumDeliveryCandles)
    float rollingLow = ta.lowest(low, maximumDeliveryCandles)
    bool bullishCandle = close > open
    bool bearishCandle = close < open
    var int bearishRunCount = 0
    var float bearishRunOpen = na
    var float bearishRunHigh = na
    var float bearishRunLow = na
    var int bullishRunCount = 0
    var float bullishRunOpen = na
    var float bullishRunHigh = na
    var float bullishRunLow = na
    var bool bullishCandidateActive = false
    var float bullishCandidateLevel = na
    var int bullishCandidateBar = na
    var int bullishCandidateLegCount = 0
    var float bullishCandidateLegRange = na
    var bool bearishCandidateActive = false
    var float bearishCandidateLevel = na
    var int bearishCandidateBar = na
    var int bearishCandidateLegCount = 0
    var float bearishCandidateLegRange = na
    var int latestDirection = 0
    var float latestLevel = na
    var int latestEventBar = na
    var int latestLegCount = 0
    var float latestLegRange = na

    if not bearishCandle and bearishRunCount > 0
        float bearishLegRange = bearishRunHigh - bearishRunLow
        bool bearishLegQualified = (
            bearishRunCount >= requiredCandles and
            bearishLegRange >= atrValue * minimumLegAtr
        )
        if bearishLegQualified
            bullishCandidateActive := true
            bullishCandidateLevel := bearishRunOpen
            bullishCandidateBar := bar_index
            bullishCandidateLegCount := bearishRunCount
            bullishCandidateLegRange := bearishLegRange
        bearishRunCount := 0
        bearishRunOpen := na
        bearishRunHigh := na
        bearishRunLow := na

    if not bullishCandle and bullishRunCount > 0
        float bullishLegRange = bullishRunHigh - bullishRunLow
        bool bullishLegQualified = (
            bullishRunCount >= requiredCandles and
            bullishLegRange >= atrValue * minimumLegAtr
        )
        if bullishLegQualified
            bearishCandidateActive := true
            bearishCandidateLevel := bullishRunOpen
            bearishCandidateBar := bar_index
            bearishCandidateLegCount := bullishRunCount
            bearishCandidateLegRange := bullishLegRange
        bullishRunCount := 0
        bullishRunOpen := na
        bullishRunHigh := na
        bullishRunLow := na

    if bearishCandle
        if bearishRunCount == 0
            bearishRunCount := 1
            bearishRunOpen := open
            bearishRunHigh := high
            bearishRunLow := low
        else
            bearishRunCount += 1
            bearishRunHigh := math.max(bearishRunHigh, high)
            bearishRunLow := math.min(bearishRunLow, low)
            if bearishRunCount > maximumDeliveryCandles
                bearishRunCount := maximumDeliveryCandles
                bearishRunOpen := open[maximumDeliveryCandles - 1]
                bearishRunHigh := rollingHigh
                bearishRunLow := rollingLow

    if bullishCandle
        if bullishRunCount == 0
            bullishRunCount := 1
            bullishRunOpen := open
            bullishRunHigh := high
            bullishRunLow := low
        else
            bullishRunCount += 1
            bullishRunHigh := math.max(bullishRunHigh, high)
            bullishRunLow := math.min(bullishRunLow, low)
            if bullishRunCount > maximumDeliveryCandles
                bullishRunCount := maximumDeliveryCandles
                bullishRunOpen := open[maximumDeliveryCandles - 1]
                bullishRunHigh := rollingHigh
                bullishRunLow := rollingLow

    if (
        bullishCandidateActive and
        bar_index - bullishCandidateBar > confirmationBars
    )
        bullishCandidateActive := false
        bullishCandidateLevel := na

    if (
        bearishCandidateActive and
        bar_index - bearishCandidateBar > confirmationBars
    )
        bearishCandidateActive := false
        bearishCandidateLevel := na

    bool bullishEvent = (
        barstate.isconfirmed and
        bullishCandle and
        bullishCandidateActive and
        close > bullishCandidateLevel
    )
    bool bearishEvent = (
        barstate.isconfirmed and
        bearishCandle and
        bearishCandidateActive and
        close < bearishCandidateLevel
    )
    int eventPulse = 0

    if bullishEvent
        eventPulse := 1
        latestDirection := 1
        latestLevel := bullishCandidateLevel
        latestEventBar := bar_index
        latestLegCount := bullishCandidateLegCount
        latestLegRange := bullishCandidateLegRange
        bullishCandidateActive := false
        bullishCandidateLevel := na
    else if bearishEvent
        eventPulse := -1
        latestDirection := -1
        latestLevel := bearishCandidateLevel
        latestEventBar := bar_index
        latestLegCount := bearishCandidateLegCount
        latestLegRange := bearishCandidateLegRange
        bearishCandidateActive := false
        bearishCandidateLevel := na

    [eventPulse, latestDirection, latestLevel, latestEventBar, latestLegCount, latestLegRange, bullishCandidateActive ? bullishCandidateLevel : na, bullishCandidateActive ? bullishCandidateBar : na, bearishCandidateActive ? bearishCandidateLevel : na, bearishCandidateActive ? bearishCandidateBar : na]

f_displacement_state(
    bool bullishExpansion,
    bool bearishExpansion,
    bool strongExpansion,
    bool bullishContext,
    bool bearishContext,
    float structureLevel,
    float bodyMultiple,
    float rangeAtrMultiple,
    float bodyShare,
    int cisdQuality,
    int followThroughBars
) =>
    var int candidateDirection = 0
    var int candidateBar = na
    var float candidateClose = na
    var float candidateHigh = na
    var float candidateLow = na
    var float candidateStructureLevel = na
    var float candidateBodyMultiple = na
    var float candidateRangeAtrMultiple = na
    var float candidateBodyShare = na
    var int candidateCisdQuality = 0
    var bool candidateStrong = false
    var int latestDirection = 0
    var int latestQuality = 0
    var int latestEventBar = na
    var int latestExpansionBar = na
    var float latestHigh = na
    var float latestLow = na
    var float latestStructureLevel = na
    var float latestBodyMultiple = na
    var float latestRangeAtrMultiple = na
    var float latestBodyShare = na
    int eventPulse = 0

    if candidateDirection != 0
        int candidateAge = bar_index - candidateBar
        bool candidateInvalidated = (
            candidateDirection == 1 ?
            close < candidateStructureLevel :
            close > candidateStructureLevel
        )
        bool candidateFollowedThrough = (
            candidateAge > 0 and
            candidateAge <= followThroughBars and
            (
                candidateDirection == 1 ?
                close > candidateClose :
                close < candidateClose
            )
        )

        if barstate.isconfirmed and candidateFollowedThrough and not candidateInvalidated
            eventPulse := candidateDirection
            latestDirection := candidateDirection
            latestQuality := candidateStrong and candidateCisdQuality == 3 ? 3 : 2
            latestEventBar := bar_index
            latestExpansionBar := candidateBar
            latestHigh := candidateHigh
            latestLow := candidateLow
            latestStructureLevel := candidateStructureLevel
            latestBodyMultiple := candidateBodyMultiple
            latestRangeAtrMultiple := candidateRangeAtrMultiple
            latestBodyShare := candidateBodyShare
            candidateDirection := 0
        else if barstate.isconfirmed and (candidateInvalidated or candidateAge > followThroughBars)
            candidateDirection := 0

    if eventPulse == 0 and candidateDirection == 0 and barstate.isconfirmed
        bool bullishCandidate = (
            bullishExpansion and
            bullishContext and
            not na(structureLevel) and
            close > structureLevel
        )
        bool bearishCandidate = (
            bearishExpansion and
            bearishContext and
            not na(structureLevel) and
            close < structureLevel
        )

        if bullishCandidate or bearishCandidate
            candidateDirection := bullishCandidate ? 1 : -1
            candidateBar := bar_index
            candidateClose := close
            candidateHigh := high
            candidateLow := low
            candidateStructureLevel := structureLevel
            candidateBodyMultiple := bodyMultiple
            candidateRangeAtrMultiple := rangeAtrMultiple
            candidateBodyShare := bodyShare
            candidateCisdQuality := cisdQuality
            candidateStrong := strongExpansion

    [eventPulse, latestDirection, latestQuality, latestEventBar, latestExpansionBar, latestHigh, latestLow, latestStructureLevel, latestBodyMultiple, latestRangeAtrMultiple, latestBodyShare, candidateDirection, candidateBar, candidateHigh, candidateLow]

f_entry_fvg_state(int displacementPulse, int displacementExpansionBar) =>
    var int direction = 0
    var float top = na
    var float bottom = na
    var int startTime = na
    var int createdBar = na
    var int filledTime = na
    var int status = 0
    int createdPulse = 0
    int retracePulse = 0
    int filledPulse = 0

    bool firstFollowThroughBar = (
        not na(displacementExpansionBar) and
        displacementExpansionBar == bar_index - 1
    )
    bool secondFollowThroughBar = (
        not na(displacementExpansionBar) and
        displacementExpansionBar == bar_index - 2
    )
    bool bullishCurrentFvg = firstFollowThroughBar and low > high[2]
    bool bullishPriorFvg = secondFollowThroughBar and low[1] > high[3]
    bool bearishCurrentFvg = firstFollowThroughBar and high < low[2]
    bool bearishPriorFvg = secondFollowThroughBar and high[1] < low[3]
    bool bullishCreated = (
        displacementPulse == 1 and
        (bullishCurrentFvg or bullishPriorFvg)
    )
    bool bearishCreated = (
        displacementPulse == -1 and
        (bearishCurrentFvg or bearishPriorFvg)
    )

    if bullishCreated
        direction := 1
        top := bullishCurrentFvg ? low : low[1]
        bottom := bullishCurrentFvg ? high[2] : high[3]
        startTime := bullishCurrentFvg ? time[2] : time[3]
        createdBar := bullishCurrentFvg ? bar_index : bar_index - 1
        filledTime := na
        status := 1
        createdPulse := 1
    else if bearishCreated
        direction := -1
        top := bearishCurrentFvg ? low[2] : low[3]
        bottom := bearishCurrentFvg ? high : high[1]
        startTime := bearishCurrentFvg ? time[2] : time[3]
        createdBar := bearishCurrentFvg ? bar_index : bar_index - 1
        filledTime := na
        status := 1
        createdPulse := -1

    if (
        direction != 0 and
        f_fvg_active(status) and
        not na(createdBar) and
        bar_index > createdBar and
        barstate.isconfirmed
    )
        int priorStatus = status
        if direction == 1
            if low <= bottom
                status := 3
                filledTime := time
            else if low < top
                status := 2
        else
            if high >= top
                status := 3
                filledTime := time
            else if high > bottom
                status := 2

        if priorStatus == 1 and status == 2
            retracePulse := direction
        else if priorStatus != 3 and status == 3
            filledPulse := direction

    [direction, top, bottom, startTime, createdBar, filledTime, status, createdPulse, retracePulse, filledPulse]

f_timeframe_label(string value) =>
    value == "240" ? "4H" :
     value == "60" ? "1H" :
     value == "15" ? "15M" :
     value == "5" ? "5M" :
     value

// A one-bar offset with lookahead_on returns the last completed HTF state.
// This avoids using a still-forming higher-timeframe bar.
int primaryState = request.security(
    syminfo.tickerid,
    primaryTimeframe,
    f_structure_state(swingLength)[1],
    gaps = barmerge.gaps_off,
    lookahead = barmerge.lookahead_on
)
int secondaryState = request.security(
    syminfo.tickerid,
    secondaryTimeframe,
    f_structure_state(swingLength)[1],
    gaps = barmerge.gaps_off,
    lookahead = barmerge.lookahead_on
)

[primaryBullTop, primaryBullBottom, primaryBullStart, primaryBullStatus, primaryBearTop, primaryBearBottom, primaryBearStart, primaryBearStatus] = request.security(
    syminfo.tickerid,
    primaryTimeframe,
    f_fvg_state(),
    gaps = barmerge.gaps_off,
    lookahead = barmerge.lookahead_on
)
[secondaryBullTop, secondaryBullBottom, secondaryBullStart, secondaryBullStatus, secondaryBearTop, secondaryBearBottom, secondaryBearStart, secondaryBearStatus] = request.security(
    syminfo.tickerid,
    secondaryTimeframe,
    f_fvg_state(),
    gaps = barmerge.gaps_off,
    lookahead = barmerge.lookahead_on
)
[primaryBullObTop, primaryBullObBottom, primaryBullObStart, primaryBullObStatus, primaryBearObTop, primaryBearObBottom, primaryBearObStart, primaryBearObStatus] = request.security(
    syminfo.tickerid,
    primaryTimeframe,
    f_ob_state(
        obBreakLookback,
        obSourceSearchCandles,
        displacementBodyLength,
        displacementAtrLength,
        displacementMinimumBodyMultiple,
        displacementMinimumRangeAtr,
        displacementMinimumBodyShare
    ),
    gaps = barmerge.gaps_off,
    lookahead = barmerge.lookahead_on
)
[secondaryBullObTop, secondaryBullObBottom, secondaryBullObStart, secondaryBullObStatus, secondaryBearObTop, secondaryBearObBottom, secondaryBearObStart, secondaryBearObStatus] = request.security(
    syminfo.tickerid,
    secondaryTimeframe,
    f_ob_state(
        obBreakLookback,
        obSourceSearchCandles,
        displacementBodyLength,
        displacementAtrLength,
        displacementMinimumBodyMultiple,
        displacementMinimumRangeAtr,
        displacementMinimumBodyShare
    ),
    gaps = barmerge.gaps_off,
    lookahead = barmerge.lookahead_on
)
[previousDayHigh, previousDayLow] = request.security(
    syminfo.tickerid,
    "1D",
    [high[1], low[1]],
    gaps = barmerge.gaps_off,
    lookahead = barmerge.lookahead_on
)

float primarySeconds = timeframe.in_seconds(primaryTimeframe)
float secondarySeconds = timeframe.in_seconds(secondaryTimeframe)
bool timeframeOrderValid = primarySeconds > secondarySeconds
bool conflict = (
    timeframeOrderValid and
    primaryState != 0 and
    secondaryState != 0 and
    primaryState != secondaryState
)
bool aligned = (
    timeframeOrderValid and
    primaryState != 0 and
    primaryState == secondaryState
)
bool primaryOnly = (
    timeframeOrderValid and
    primaryState != 0 and
    secondaryState == 0
)

int combinedState = aligned ? primaryState : primaryOnly ? primaryState : 0
string confidence = aligned ? "HIGH" : primaryOnly ? "MEDIUM" : "LOW"
string alignmentState = (
    not timeframeOrderValid ? "INVALID TF ORDER" :
    conflict ? "CONFLICT" :
    aligned ? "ALIGNED" :
    primaryOnly ? "PRIMARY ONLY" :
    "WAIT"
)
color alignmentColor = (
    not timeframeOrderValid or conflict ? warningColor :
    aligned ? bullishColor :
    primaryOnly ? warningColor :
    neutralColor
)

int primaryObDirection = (
    combinedState == 1 and f_ob_active(primaryBullObStatus) ? 1 :
    combinedState == -1 and f_ob_active(primaryBearObStatus) ? -1 :
    0
)
float primaryObTop = (
    primaryObDirection == 1 ? primaryBullObTop :
    primaryObDirection == -1 ? primaryBearObTop :
    na
)
float primaryObBottom = (
    primaryObDirection == 1 ? primaryBullObBottom :
    primaryObDirection == -1 ? primaryBearObBottom :
    na
)
int primaryObStart = (
    primaryObDirection == 1 ? primaryBullObStart :
    primaryObDirection == -1 ? primaryBearObStart :
    na
)
int primaryObStatus = (
    primaryObDirection == 1 ? primaryBullObStatus :
    primaryObDirection == -1 ? primaryBearObStatus :
    0
)
bool primaryObActive = (
    primaryObDirection != 0 and
    f_ob_active(primaryObStatus)
)

int secondaryObDirection = (
    combinedState == 1 and f_ob_active(secondaryBullObStatus) ? 1 :
    combinedState == -1 and f_ob_active(secondaryBearObStatus) ? -1 :
    0
)
float secondaryObTop = (
    secondaryObDirection == 1 ? secondaryBullObTop :
    secondaryObDirection == -1 ? secondaryBearObTop :
    na
)
float secondaryObBottom = (
    secondaryObDirection == 1 ? secondaryBullObBottom :
    secondaryObDirection == -1 ? secondaryBearObBottom :
    na
)
int secondaryObStart = (
    secondaryObDirection == 1 ? secondaryBullObStart :
    secondaryObDirection == -1 ? secondaryBearObStart :
    na
)
int secondaryObStatus = (
    secondaryObDirection == 1 ? secondaryBullObStatus :
    secondaryObDirection == -1 ? secondaryBearObStatus :
    0
)
bool secondaryObActive = (
    secondaryObDirection != 0 and
    f_ob_active(secondaryObStatus)
)

bool primaryBullAvailable = f_fvg_active(primaryBullStatus)
bool primaryBearAvailable = f_fvg_active(primaryBearStatus)
bool secondaryBullAvailable = f_fvg_active(secondaryBullStatus)
bool secondaryBearAvailable = f_fvg_active(secondaryBearStatus)
bool usePrimaryBull = combinedState == 1 and primaryBullAvailable
bool useSecondaryBull = (
    combinedState == 1 and
    not primaryBullAvailable and
    secondaryBullAvailable
)
bool usePrimaryBear = combinedState == -1 and primaryBearAvailable
bool useSecondaryBear = (
    combinedState == -1 and
    not primaryBearAvailable and
    secondaryBearAvailable
)

int poiDirection = (
    usePrimaryBull or useSecondaryBull ? 1 :
    usePrimaryBear or useSecondaryBear ? -1 :
    0
)
float poiTop = (
    usePrimaryBull ? primaryBullTop :
    useSecondaryBull ? secondaryBullTop :
    usePrimaryBear ? primaryBearTop :
    useSecondaryBear ? secondaryBearTop :
    na
)
float poiBottom = (
    usePrimaryBull ? primaryBullBottom :
    useSecondaryBull ? secondaryBullBottom :
    usePrimaryBear ? primaryBearBottom :
    useSecondaryBear ? secondaryBearBottom :
    na
)
int poiStart = (
    usePrimaryBull ? primaryBullStart :
    useSecondaryBull ? secondaryBullStart :
    usePrimaryBear ? primaryBearStart :
    useSecondaryBear ? secondaryBearStart :
    na
)
int poiStatus = (
    usePrimaryBull ? primaryBullStatus :
    useSecondaryBull ? secondaryBullStatus :
    usePrimaryBear ? primaryBearStatus :
    useSecondaryBear ? secondaryBearStatus :
    0
)
string poiTimeframe = (
    usePrimaryBull or usePrimaryBear ? f_timeframe_label(primaryTimeframe) :
    useSecondaryBull or useSecondaryBear ? f_timeframe_label(secondaryTimeframe) :
    "--"
)
bool poiActive = poiDirection != 0 and f_fvg_active(poiStatus)
bool priceInsidePoi = (
    poiActive and
    close <= poiTop and
    close >= poiBottom
)
bool priceTouchesPoi = (
    poiActive and
    high >= poiBottom and
    low <= poiTop
)
bool poiInteractionActive = priceInsidePoi or priceTouchesPoi
string poiLocation = (
    priceInsidePoi ? "IN ZONE" :
    priceTouchesPoi ? "TOUCH" :
    poiActive ? "AWAY" :
    "--"
)
bool newExchangeDay = ta.change(time("1D")) != 0
var bool pdhSweptToday = false
var bool pdlSweptToday = false

if newExchangeDay
    pdhSweptToday := false
    pdlSweptToday := false

bool pdhSweepEvent = (
    barstate.isconfirmed and
    not pdhSweptToday and
    not na(previousDayHigh) and
    high > previousDayHigh and
    close < previousDayHigh
)
bool pdlSweepEvent = (
    barstate.isconfirmed and
    not pdlSweptToday and
    not na(previousDayLow) and
    low < previousDayLow and
    close > previousDayLow
)

if pdhSweepEvent
    pdhSweptToday := true
if pdlSweepEvent
    pdlSweptToday := true

int barsSincePdhSweep = ta.barssince(pdhSweepEvent)
int barsSincePdlSweep = ta.barssince(pdlSweepEvent)
bool recentPdhSweep = (
    not na(barsSincePdhSweep) and
    barsSincePdhSweep <= structureContextBars
)
bool recentPdlSweep = (
    not na(barsSincePdlSweep) and
    barsSincePdlSweep <= structureContextBars
)

[structureEventPulse, latestStructureEvent, latestStructureDirection, executionTrendState, latestStructureLevel, latestStructureEventBar, latestStructureOriginBar, latestExecutionSwingHigh, latestExecutionSwingLow, latestExecutionSwingHighBar, latestExecutionSwingLowBar, latestExecutionHighBroken, latestExecutionLowBroken] = f_execution_structure(
    structureSwingLength,
    recentPdhSweep,
    recentPdlSweep
)

bool structureEventActive = (
    latestStructureEvent != 0 and
    not na(latestStructureEventBar) and
    bar_index - latestStructureEventBar <= structureContextBars
)
bool structureAligned = (
    structureEventActive and
    combinedState != 0 and
    latestStructureDirection == combinedState
)
string structureState = (
    structureEventActive ?
    f_structure_event_text(latestStructureEvent) + " " +
    f_state_short(latestStructureDirection) :
    "WAIT"
)
color structureStateColor = (
    not structureEventActive ? neutralColor :
    structureAligned ? f_state_color(latestStructureDirection) :
    warningColor
)

[cisdEventPulse, latestCisdDirection, latestCisdLevel, latestCisdEventBar, latestCisdLegCount, latestCisdLegRange, bullishCisdCandidateLevel, bullishCisdCandidateBar, bearishCisdCandidateLevel, bearishCisdCandidateBar] = f_cisd_state(
    cisdMinimumDeliveryCandles,
    cisdMaximumDeliveryCandles,
    cisdAtrLength,
    cisdMinimumLegAtr,
    cisdConfirmationBars
)

bool cisdEventActive = (
    latestCisdDirection != 0 and
    not na(latestCisdEventBar) and
    bar_index - latestCisdEventBar <= cisdContextBars
)
bool cisdAligned = (
    cisdEventActive and
    combinedState != 0 and
    latestCisdDirection == combinedState
)
bool cisdMatchingSweep = (
    latestCisdDirection == 1 ? recentPdlSweep :
    latestCisdDirection == -1 ? recentPdhSweep :
    false
)
bool cisdMatchingStructure = (
    structureEventActive and
    latestCisdDirection == latestStructureDirection
)
bool cisdMatchingPoi = (
    poiInteractionActive and
    latestCisdDirection == poiDirection
)
bool cisdContextAvailable = (
    cisdMatchingSweep or
    cisdMatchingStructure or
    cisdMatchingPoi
)
int cisdQuality = (
    not cisdEventActive ? 0 :
    (
        cisdAligned and
        cisdMatchingStructure and
        (cisdMatchingSweep or cisdMatchingPoi)
    ) ? 3 :
    cisdAligned and cisdContextAvailable ? 2 :
    1
)
bool cisdValid = cisdQuality >= 2
string cisdState = (
    cisdEventActive ?
    f_state_short(latestCisdDirection) + " · " +
    f_quality_text(cisdQuality) :
    "WAIT"
)
color cisdStateColor = (
    not cisdEventActive ? neutralColor :
    cisdValid ? f_state_color(latestCisdDirection) :
    warningColor
)

float displacementBody = math.abs(close - open)
float displacementRange = high - low
float displacementAverageBody = ta.sma(displacementBody, displacementBodyLength)[1]
float displacementAtr = ta.atr(displacementAtrLength)[1]
float displacementBodyMultiple = (
    not na(displacementAverageBody) and displacementAverageBody > 0.0 ?
    displacementBody / displacementAverageBody :
    0.0
)
float displacementRangeAtr = (
    not na(displacementAtr) and displacementAtr > 0.0 ?
    displacementRange / displacementAtr :
    0.0
)
float displacementBodyShare = (
    displacementRange > 0.0 ?
    displacementBody / displacementRange :
    0.0
)
bool bullishDisplacementExpansion = (
    barstate.isconfirmed and
    close > open and
    displacementBodyMultiple >= displacementMinimumBodyMultiple and
    displacementRangeAtr >= displacementMinimumRangeAtr and
    displacementBodyShare >= displacementMinimumBodyShare
)
bool bearishDisplacementExpansion = (
    barstate.isconfirmed and
    close < open and
    displacementBodyMultiple >= displacementMinimumBodyMultiple and
    displacementRangeAtr >= displacementMinimumRangeAtr and
    displacementBodyShare >= displacementMinimumBodyShare
)
bool strongDisplacementExpansion = (
    displacementBodyMultiple >= displacementMinimumBodyMultiple * 1.5 and
    displacementRangeAtr >= displacementMinimumRangeAtr * 1.25 and
    displacementBodyShare >= math.max(displacementMinimumBodyShare, 0.7)
)
bool bullishDisplacementContext = (
    combinedState == 1 and
    structureEventActive and
    latestStructureDirection == 1 and
    cisdValid and
    latestCisdDirection == 1
)
bool bearishDisplacementContext = (
    combinedState == -1 and
    structureEventActive and
    latestStructureDirection == -1 and
    cisdValid and
    latestCisdDirection == -1
)

[displacementEventPulse, latestDisplacementDirection, latestDisplacementQuality, latestDisplacementEventBar, latestDisplacementExpansionBar, latestDisplacementHigh, latestDisplacementLow, latestDisplacementStructureLevel, latestDisplacementBodyMultiple, latestDisplacementRangeAtr, latestDisplacementBodyShare, displacementCandidateDirection, displacementCandidateBar, displacementCandidateHigh, displacementCandidateLow] = f_displacement_state(
    bullishDisplacementExpansion,
    bearishDisplacementExpansion,
    strongDisplacementExpansion,
    bullishDisplacementContext,
    bearishDisplacementContext,
    latestStructureLevel,
    displacementBodyMultiple,
    displacementRangeAtr,
    displacementBodyShare,
    cisdQuality,
    displacementFollowThroughBars
)

bool displacementEventActive = (
    latestDisplacementDirection != 0 and
    not na(latestDisplacementEventBar) and
    bar_index - latestDisplacementEventBar <= displacementContextBars
)
bool displacementCandidateActive = (
    displacementCandidateDirection != 0 and
    not na(displacementCandidateBar) and
    bar_index - displacementCandidateBar <= displacementFollowThroughBars
)
bool displacementAligned = (
    displacementEventActive and
    combinedState != 0 and
    latestDisplacementDirection == combinedState
)
bool displacementValid = (
    displacementAligned and
    latestDisplacementQuality >= 2
)
string displacementState = (
    displacementEventActive ?
    (
        displacementAligned ?
        f_state_short(latestDisplacementDirection) + " · " +
        f_quality_text(latestDisplacementQuality) :
        f_state_short(latestDisplacementDirection) + " · CONFLICT"
    ) :
    displacementCandidateActive ?
    f_state_short(displacementCandidateDirection) + " · WATCH" :
    "WAIT"
)
color displacementStateColor = (
    displacementValid ? f_state_color(latestDisplacementDirection) :
    displacementCandidateActive or displacementEventActive ? warningColor :
    neutralColor
)

[entryFvgDirection, entryFvgTop, entryFvgBottom, entryFvgStartTime, entryFvgCreatedBar, entryFvgFilledTime, entryFvgStatus, entryFvgCreatedPulse, entryFvgRetracePulse, entryFvgFilledPulse] = f_entry_fvg_state(
    displacementEventPulse,
    latestDisplacementExpansionBar
)
bool entryFvgExists = (
    entryFvgDirection != 0 and
    entryFvgStatus != 0 and
    not na(entryFvgTop) and
    not na(entryFvgBottom)
)
bool entryFvgActive = entryFvgExists and f_fvg_active(entryFvgStatus)
bool priceInsideEntryFvg = (
    entryFvgActive and
    close <= entryFvgTop and
    close >= entryFvgBottom
)
bool priceTouchesEntryFvg = (
    entryFvgActive and
    high >= entryFvgBottom and
    low <= entryFvgTop
)
bool entryFvgInteractionActive = (
    priceInsideEntryFvg or
    priceTouchesEntryFvg
)

// Lock the first risk plan for each new Entry FVG. Later swing updates do not
// move the plan, so Entry, Stop, Target, and RR remain auditable.
var int riskPlanDirection = 0
var int riskPlanFvgCreatedBar = na
var int riskPlanStartTime = na
var float plannedEntry = na
var float plannedStop = na
var float plannedTarget = na

if entryFvgCreatedPulse != 0
    riskPlanDirection := entryFvgDirection
    riskPlanFvgCreatedBar := entryFvgCreatedBar
    riskPlanStartTime := time
    plannedEntry := (entryFvgTop + entryFvgBottom) / 2.0
    plannedStop := (
        entryFvgDirection == 1 ?
        latestExecutionSwingLow :
        latestExecutionSwingHigh
    )
    plannedTarget := (
        entryFvgDirection == 1 ?
        previousDayHigh :
        previousDayLow
    )

bool riskPlanMatchesEntryFvg = (
    entryFvgExists and
    not na(riskPlanFvgCreatedBar) and
    riskPlanFvgCreatedBar == entryFvgCreatedBar and
    riskPlanDirection == entryFvgDirection
)
bool plannedStopValid = (
    riskPlanMatchesEntryFvg and
    not na(plannedEntry) and
    not na(plannedStop) and
    (
        riskPlanDirection == 1 ?
        plannedStop < plannedEntry :
        plannedStop > plannedEntry
    )
)
bool plannedTargetValid = (
    riskPlanMatchesEntryFvg and
    not na(plannedEntry) and
    not na(plannedTarget) and
    (
        riskPlanDirection == 1 ?
        plannedTarget > plannedEntry :
        plannedTarget < plannedEntry
    )
)
float plannedRisk = (
    plannedStopValid ?
    math.abs(plannedEntry - plannedStop) :
    na
)
float plannedReward = (
    plannedTargetValid ?
    math.abs(plannedTarget - plannedEntry) :
    na
)
float plannedRr = (
    not na(plannedRisk) and
    plannedRisk > 0.0 and
    not na(plannedReward) ?
    plannedReward / plannedRisk :
    na
)
bool riskPlanAvailable = (
    entryFvgActive and
    riskPlanMatchesEntryFvg and
    plannedStopValid and
    plannedTargetValid and
    not na(plannedRr)
)
bool riskPlanValid = (
    riskPlanAvailable and
    plannedRr >= minimumPlannedRr
)

// Preserve a POI touch for the current selected zone so later confirmation
// events can remain part of the same developing setup after price leaves it.
int setupContextBars = math.max(
    structureContextBars,
    math.max(cisdContextBars, displacementContextBars)
)
var int latestPoiInteractionBar = na
var int latestPoiInteractionStart = na
var int latestPoiInteractionDirection = 0

if barstate.isconfirmed and poiInteractionActive
    latestPoiInteractionBar := bar_index
    latestPoiInteractionStart := poiStart
    latestPoiInteractionDirection := poiDirection

bool poiRecentlyInteracted = (
    poiActive and
    not na(latestPoiInteractionBar) and
    not na(latestPoiInteractionStart) and
    latestPoiInteractionStart == poiStart and
    latestPoiInteractionDirection == poiDirection and
    bar_index - latestPoiInteractionBar <= setupContextBars
)
bool liquidityAligned = (
    combinedState == 1 ? recentPdlSweep :
    combinedState == -1 ? recentPdhSweep :
    false
)
bool entryFvgAligned = (
    entryFvgActive and
    combinedState != 0 and
    entryFvgDirection == combinedState
)
bool structureConflict = (
    structureEventActive and
    combinedState != 0 and
    latestStructureDirection != combinedState
)
bool cisdConflict = (
    cisdEventActive and
    combinedState != 0 and
    latestCisdDirection != combinedState
)
bool displacementConflict = (
    displacementEventActive and
    combinedState != 0 and
    latestDisplacementDirection != combinedState
)
bool entryFvgConflict = (
    entryFvgActive and
    combinedState != 0 and
    entryFvgDirection != combinedState
)
bool contextBlocked = (
    not timeframeOrderValid or
    conflict or
    structureConflict or
    cisdConflict or
    displacementConflict or
    entryFvgConflict or
    entryFvgFilledPulse != 0
)

// score-v1 automation mapping.
int htfScore = aligned ? 20 : primaryOnly ? 10 : 0
int poiScore = poiRecentlyInteracted ? 15 : poiActive ? 5 : 0
int liquidityScore = liquidityAligned ? 15 : 0
int structureScore = structureAligned ? 15 : 0
int cisdScore = cisdValid and cisdAligned ? 15 : 0
int displacementScore = displacementValid ? 10 : 0
int entryFvgScore = (
    entryFvgAligned ?
    3 + (entryFvgStatus == 2 or entryFvgInteractionActive ? 2 : 0) :
    0
)
int automatedScoreRaw = (
    htfScore +
    poiScore +
    liquidityScore +
    structureScore +
    cisdScore +
    displacementScore +
    entryFvgScore
)
bool automatedSetupComplete = (
    not contextBlocked and
    barstate.isconfirmed and
    aligned and
    poiRecentlyInteracted and
    liquidityAligned and
    structureAligned and
    cisdValid and
    cisdAligned and
    displacementValid and
    entryFvgAligned and
    entryFvgInteractionActive
)
bool riskBlocked = (
    automatedSetupComplete and
    riskPlanAvailable and
    not riskPlanValid
)
bool setupBlocked = contextBlocked or riskBlocked
int automatedScore = setupBlocked ? 0 : automatedScoreRaw
int riskScore = riskPlanValid ? 5 : 0
int setupScoreRaw = automatedScoreRaw + riskScore
int setupScore = setupBlocked ? 0 : setupScoreRaw
bool entryReady = automatedSetupComplete and riskPlanValid
int setupStateCode = (
    setupBlocked ? -1 :
    entryReady ? 3 :
    automatedSetupComplete ? 2 :
    setupScore >= 25 ? 1 :
    0
)
string setupState = (
    setupStateCode == -1 ? "NO TRADE" :
    setupStateCode == 3 ? "READY" :
    setupStateCode == 2 ? "RISK REVIEW" :
    setupStateCode == 1 ? "DEVELOPING" :
    "WAITING"
)
int setupNextStepCode = (
    setupBlocked ? -1 :
    combinedState == 0 ? 1 :
    not poiActive ? 2 :
    not poiRecentlyInteracted ? 3 :
    not liquidityAligned ? 4 :
    not structureAligned ? 5 :
    not (cisdValid and cisdAligned) ? 6 :
    not displacementValid ? 7 :
    not entryFvgAligned ? 8 :
    not entryFvgInteractionActive ? 9 :
    not riskPlanValid ? 10 :
    11
)
int finalGradeCode = (
    setupStateCode == -1 ? -1 :
    setupStateCode != 3 ? 0 :
    setupScore >= 90 ? 5 :
    setupScore >= 80 ? 4 :
    setupScore >= 70 ? 3 :
    setupScore >= 60 ? 2 :
    1
)
string finalGrade = (
    finalGradeCode == -1 ? "NO TRADE" :
    finalGradeCode == 5 ? "A+" :
    finalGradeCode == 4 ? "A" :
    finalGradeCode == 3 ? "B" :
    finalGradeCode == 2 ? "C" :
    finalGradeCode == 1 ? "D" :
    "--"
)
string dashboardStatusLabel = "Setup"
string dashboardStatusValue = (
    setupState + " · " +
    str.tostring(setupScore) + "/100 · " +
    finalGrade
)
bool dashboardStatusActive = setupStateCode != 0
color dashboardStatusColor = (
    setupStateCode == -1 ? bearishColor :
    setupStateCode == 2 ? warningColor :
    setupStateCode == 3 and combinedState != 0 ?
    f_state_color(combinedState) :
    setupStateCode == 1 and combinedState != 0 ?
    f_state_color(combinedState) :
    neutralColor
)

var int latestPoiAlertStart = na
var int latestPoiAlertDirection = 0
bool poiTouchAlertPulse = (
    barstate.isconfirmed and
    poiInteractionActive and
    not na(poiStart) and
    (
        na(latestPoiAlertStart) or
        latestPoiAlertStart != poiStart or
        latestPoiAlertDirection != poiDirection
    )
)

if poiTouchAlertPulse
    latestPoiAlertStart := poiStart
    latestPoiAlertDirection := poiDirection

bool cisdValidAlertPulse = (
    barstate.isconfirmed and
    cisdValid and
    (
        cisdEventPulse != 0 or
        not cisdValid[1]
    )
)
bool riskReviewAlertPulse = (
    barstate.isconfirmed and
    setupStateCode == 2 and
    nz(setupStateCode[1], 0) != 2
)
bool readyAlertPulse = (
    barstate.isconfirmed and
    entryReady and
    not entryReady[1]
)
bool noTradeAlertPulse = (
    barstate.isconfirmed and
    setupStateCode == -1 and
    nz(setupStateCode[1], 0) != -1
)

if enableAlerts and barstate.isconfirmed
    string barAlertEvents = ""

    if alertPoiTouch and poiTouchAlertPulse
        barAlertEvents := f_append_alert_event(
            barAlertEvents,
            (
                "POI TOUCHED " +
                poiTimeframe + " " +
                f_state_short(poiDirection) +
                " FVG"
            )
        )

    if alertLiquiditySweep and pdhSweepEvent
        barAlertEvents := f_append_alert_event(
            barAlertEvents,
            "PDH SWEPT"
        )

    if alertLiquiditySweep and pdlSweepEvent
        barAlertEvents := f_append_alert_event(
            barAlertEvents,
            "PDL SWEPT"
        )

    if alertStructureConfirmation and structureEventPulse != 0
        barAlertEvents := f_append_alert_event(
            barAlertEvents,
            (
                f_structure_event_text(structureEventPulse) + " " +
                f_state_short(latestStructureDirection)
            )
        )

    if alertCisdConfirmation and cisdValidAlertPulse
        barAlertEvents := f_append_alert_event(
            barAlertEvents,
            (
                "CISD " +
                f_state_short(latestCisdDirection) + " " +
                f_quality_text(cisdQuality)
            )
        )

    if (
        alertDisplacementConfirmation and
        displacementEventPulse != 0
    )
        barAlertEvents := f_append_alert_event(
            barAlertEvents,
            (
                "DISPLACEMENT " +
                f_state_short(latestDisplacementDirection) + " " +
                f_quality_text(latestDisplacementQuality)
            )
        )

    if alertEntryFvgEvents and entryFvgCreatedPulse != 0
        barAlertEvents := f_append_alert_event(
            barAlertEvents,
            (
                "ENTRY FVG CREATED " +
                f_state_short(entryFvgCreatedPulse)
            )
        )

    if alertEntryFvgEvents and entryFvgRetracePulse != 0
        barAlertEvents := f_append_alert_event(
            barAlertEvents,
            (
                "ENTRY FVG RETRACE " +
                f_state_short(entryFvgRetracePulse)
            )
        )

    if alertEntryFvgEvents and entryFvgFilledPulse != 0
        barAlertEvents := f_append_alert_event(
            barAlertEvents,
            (
                "ENTRY FVG FILLED " +
                f_state_short(entryFvgFilledPulse)
            )
        )

    if alertRiskReview and riskReviewAlertPulse
        barAlertEvents := f_append_alert_event(
            barAlertEvents,
            "RISK REVIEW"
        )

    if alertReady and readyAlertPulse
        barAlertEvents := f_append_alert_event(
            barAlertEvents,
            (
                "READY TO ENTER " +
                f_state_short(combinedState)
            )
        )

    if alertNoTrade and noTradeAlertPulse
        barAlertEvents := f_append_alert_event(
            barAlertEvents,
            "NO TRADE"
        )

    if barAlertEvents != ""
        string plannedRrAlertText = (
            riskPlanAvailable ?
            str.tostring(plannedRr, "#.##") + "R" :
            "--"
        )
        string tradingOsAlertMessage = (
            "Trading OS v0.10.0 | " +
            syminfo.tickerid + " | " +
            timeframe.period + " | " +
            barAlertEvents + " | State " +
            setupState + " | Score " +
            str.tostring(setupScore) + "/100 | Grade " +
            finalGrade + " | RR " +
            plannedRrAlertText + " | Close " +
            str.tostring(close, format.mintick)
        )
        alert(
            tradingOsAlertMessage,
            alert.freq_once_per_bar_close
        )

string liquidityState = (
    pdhSweptToday and pdlSweptToday ? "PDH + PDL SWEPT" :
    pdhSweptToday ? "PDH SWEPT" :
    pdlSweptToday ? "PDL SWEPT" :
    "PDH / PDL WAIT"
)
color liquidityStateColor = (
    pdhSweptToday and pdlSweptToday ? warningColor :
    pdhSweptToday ? bearishColor :
    pdlSweptToday ? bullishColor :
    neutralColor
)

color backgroundColor = (
    showBiasBackground and timeframeOrderValid and combinedState != 0 ?
    color.new(f_state_color(combinedState), 92) :
    na
)
bgcolor(backgroundColor, title = "Confirmed HTF bias")

// Chart drawings use actual bar time/index and price coordinates. They never
// depend on the visible viewport, so scrolling does not relocate the context.
var box poiBox = na
if barstate.islast
    if showHtfFvg and poiActive and not na(poiStart)
        color poiColor = f_state_color(poiDirection)
        string poiText = (
            poiTimeframe + " " +
            f_state_short(poiDirection) + " FVG · " +
            f_fvg_status_text(poiStatus)
        )
        if na(poiBox)
            poiBox := box.new(
                left = poiStart,
                top = poiTop,
                right = time,
                bottom = poiBottom,
                xloc = xloc.bar_time,
                extend = extend.right,
                border_color = color.new(poiColor, 18),
                border_width = 1,
                bgcolor = color.new(poiColor, 88),
                text = poiText,
                text_color = color.new(poiColor, 4),
                text_size = size.tiny,
                text_halign = text.align_left,
                text_valign = text.align_top
            )
        else
            box.set_left(poiBox, poiStart)
            box.set_top(poiBox, poiTop)
            box.set_right(poiBox, time)
            box.set_bottom(poiBox, poiBottom)
            box.set_extend(poiBox, extend.right)
            box.set_border_color(poiBox, color.new(poiColor, 18))
            box.set_bgcolor(poiBox, color.new(poiColor, 88))
            box.set_text(poiBox, poiText)
            box.set_text_color(poiBox, color.new(poiColor, 4))
    else if not na(poiBox)
        box.delete(poiBox)
        poiBox := na

var box primaryObBox = na
var box secondaryObBox = na
if barstate.islast
    if (
        showHtfOrderBlocks and
        primaryObActive and
        not na(primaryObStart)
    )
        color primaryObColor = f_state_color(primaryObDirection)
        string primaryObText = (
            f_timeframe_label(primaryTimeframe) + " " +
            f_state_short(primaryObDirection) + " OB · " +
            f_ob_status_text(primaryObStatus)
        )
        if na(primaryObBox)
            primaryObBox := box.new(
                left = primaryObStart,
                top = primaryObTop,
