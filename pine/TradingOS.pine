                bottom = primaryObBottom,
                xloc = xloc.bar_time,
                extend = extend.right,
                border_color = color.new(primaryObColor, 8),
                border_width = 2,
                border_style = line.style_dashed,
                bgcolor = color.new(primaryObColor, 91),
                text = primaryObText,
                text_color = color.new(primaryObColor, 2),
                text_size = size.tiny,
                text_halign = text.align_left,
                text_valign = text.align_bottom
            )
        else
            box.set_left(primaryObBox, primaryObStart)
            box.set_top(primaryObBox, primaryObTop)
            box.set_right(primaryObBox, time)
            box.set_bottom(primaryObBox, primaryObBottom)
            box.set_extend(primaryObBox, extend.right)
            box.set_border_color(
                primaryObBox,
                color.new(primaryObColor, 8)
            )
            box.set_bgcolor(
                primaryObBox,
                color.new(primaryObColor, 91)
            )
            box.set_text(primaryObBox, primaryObText)
            box.set_text_color(
                primaryObBox,
                color.new(primaryObColor, 2)
            )
    else if not na(primaryObBox)
        box.delete(primaryObBox)
        primaryObBox := na

    if (
        showHtfOrderBlocks and
        secondaryObActive and
        not na(secondaryObStart)
    )
        color secondaryObColor = f_state_color(secondaryObDirection)
        string secondaryObText = (
            f_timeframe_label(secondaryTimeframe) + " " +
            f_state_short(secondaryObDirection) + " OB · " +
            f_ob_status_text(secondaryObStatus)
        )
        if na(secondaryObBox)
            secondaryObBox := box.new(
                left = secondaryObStart,
                top = secondaryObTop,
                right = time,
                bottom = secondaryObBottom,
                xloc = xloc.bar_time,
                extend = extend.right,
                border_color = color.new(secondaryObColor, 32),
                border_width = 1,
                border_style = line.style_dashed,
                bgcolor = color.new(secondaryObColor, 94),
                text = secondaryObText,
                text_color = color.new(secondaryObColor, 18),
                text_size = size.tiny,
                text_halign = text.align_left,
                text_valign = text.align_bottom
            )
        else
            box.set_left(secondaryObBox, secondaryObStart)
            box.set_top(secondaryObBox, secondaryObTop)
            box.set_right(secondaryObBox, time)
            box.set_bottom(secondaryObBox, secondaryObBottom)
            box.set_extend(secondaryObBox, extend.right)
            box.set_border_color(
                secondaryObBox,
                color.new(secondaryObColor, 32)
            )
            box.set_bgcolor(
                secondaryObBox,
                color.new(secondaryObColor, 94)
            )
            box.set_text(secondaryObBox, secondaryObText)
            box.set_text_color(
                secondaryObBox,
                color.new(secondaryObColor, 18)
            )
    else if not na(secondaryObBox)
        box.delete(secondaryObBox)
        secondaryObBox := na

var label pdhLabel = na
var label pdlLabel = na
if barstate.islast
    if showDailyLiquidity and not na(previousDayHigh)
        if na(pdhLabel)
            pdhLabel := label.new(
                x = bar_index + 1,
                y = previousDayHigh,
                text = "PDH",
                xloc = xloc.bar_index,
                style = label.style_label_left,
                color = color.new(bearishColor, 72),
                textcolor = bearishColor,
                size = size.tiny
            )
        else
            label.set_xy(pdhLabel, bar_index + 1, previousDayHigh)
            label.set_text(pdhLabel, "PDH")
    else if not na(pdhLabel)
        label.delete(pdhLabel)
        pdhLabel := na

    if showDailyLiquidity and not na(previousDayLow)
        if na(pdlLabel)
            pdlLabel := label.new(
                x = bar_index + 1,
                y = previousDayLow,
                text = "PDL",
                xloc = xloc.bar_index,
                style = label.style_label_left,
                color = color.new(bullishColor, 72),
                textcolor = bullishColor,
                size = size.tiny
            )
        else
            label.set_xy(pdlLabel, bar_index + 1, previousDayLow)
            label.set_text(pdlLabel, "PDL")
    else if not na(pdlLabel)
        label.delete(pdlLabel)
        pdlLabel := na

var line swingHighLine = na
var line swingLowLine = na
var label swingHighLabel = na
var label swingLowLabel = na
if barstate.islast
    if (
        showStructureLevels and
        not na(latestExecutionSwingHigh) and
        not na(latestExecutionSwingHighBar)
    )
        color swingHighColor = color.new(
            bearishColor,
            latestExecutionHighBroken ? 68 : 24
        )
        if na(swingHighLine)
            swingHighLine := line.new(
                x1 = latestExecutionSwingHighBar,
                y1 = latestExecutionSwingHigh,
                x2 = bar_index + 1,
                y2 = latestExecutionSwingHigh,
                xloc = xloc.bar_index,
                extend = extend.right,
                color = swingHighColor,
                style = latestExecutionHighBroken ?
                    line.style_dotted :
                    line.style_dashed,
                width = 1
            )
        else
            line.set_xy1(
                swingHighLine,
                latestExecutionSwingHighBar,
                latestExecutionSwingHigh
            )
            line.set_xy2(
                swingHighLine,
                bar_index + 1,
                latestExecutionSwingHigh
            )
            line.set_color(swingHighLine, swingHighColor)
            line.set_style(
                swingHighLine,
                latestExecutionHighBroken ?
                    line.style_dotted :
                    line.style_dashed
            )
        if na(swingHighLabel)
            swingHighLabel := label.new(
                x = bar_index + 1,
                y = latestExecutionSwingHigh,
                text = "SH",
                xloc = xloc.bar_index,
                style = label.style_label_left,
                color = color.new(bearishColor, 78),
                textcolor = bearishColor,
                size = size.tiny
            )
        else
            label.set_xy(
                swingHighLabel,
                bar_index + 1,
                latestExecutionSwingHigh
            )
    else
        if not na(swingHighLine)
            line.delete(swingHighLine)
            swingHighLine := na
        if not na(swingHighLabel)
            label.delete(swingHighLabel)
            swingHighLabel := na

    if (
        showStructureLevels and
        not na(latestExecutionSwingLow) and
        not na(latestExecutionSwingLowBar)
    )
        color swingLowColor = color.new(
            bullishColor,
            latestExecutionLowBroken ? 68 : 24
        )
        if na(swingLowLine)
            swingLowLine := line.new(
                x1 = latestExecutionSwingLowBar,
                y1 = latestExecutionSwingLow,
                x2 = bar_index + 1,
                y2 = latestExecutionSwingLow,
                xloc = xloc.bar_index,
                extend = extend.right,
                color = swingLowColor,
                style = latestExecutionLowBroken ?
                    line.style_dotted :
                    line.style_dashed,
                width = 1
            )
        else
            line.set_xy1(
                swingLowLine,
                latestExecutionSwingLowBar,
                latestExecutionSwingLow
            )
            line.set_xy2(
                swingLowLine,
                bar_index + 1,
                latestExecutionSwingLow
            )
            line.set_color(swingLowLine, swingLowColor)
            line.set_style(
                swingLowLine,
                latestExecutionLowBroken ?
                    line.style_dotted :
                    line.style_dashed
            )
        if na(swingLowLabel)
            swingLowLabel := label.new(
                x = bar_index + 1,
                y = latestExecutionSwingLow,
                text = "SL",
                xloc = xloc.bar_index,
                style = label.style_label_left,
                color = color.new(bullishColor, 78),
                textcolor = bullishColor,
                size = size.tiny
            )
        else
            label.set_xy(
                swingLowLabel,
                bar_index + 1,
                latestExecutionSwingLow
            )
    else
        if not na(swingLowLine)
            line.delete(swingLowLine)
            swingLowLine := na
        if not na(swingLowLabel)
            label.delete(swingLowLabel)
            swingLowLabel := na

if (
    showStructureEvents and
    structureEventPulse != 0 and
    not na(latestStructureOriginBar) and
    not na(latestStructureLevel)
)
    color structureEventColor = (
        structureEventPulse == 2 ?
        warningColor :
        f_state_color(latestStructureDirection)
    )
    string structureEventLabel = (
        f_structure_event_text(structureEventPulse) + " " +
        f_state_short(latestStructureDirection)
    )
    line.new(
        x1 = latestStructureOriginBar,
        y1 = latestStructureLevel,
        x2 = latestStructureEventBar,
        y2 = latestStructureLevel,
        xloc = xloc.bar_index,
        extend = extend.none,
        color = structureEventColor,
        style = line.style_solid,
        width = structureEventPulse == 3 ? 2 : 1
    )
    label.new(
        x = latestStructureEventBar,
        y = latestStructureLevel,
        text = structureEventLabel,
        xloc = xloc.bar_index,
        style = latestStructureDirection == 1 ?
            label.style_label_down :
            label.style_label_up,
        color = color.new(structureEventColor, 12),
        textcolor = panelColor,
        size = size.tiny
    )

var line bullishCisdCandidateLine = na
var line bearishCisdCandidateLine = na

if (
    showCisdLevels and
    not na(bullishCisdCandidateLevel) and
    not na(bullishCisdCandidateBar)
)
    if na(bullishCisdCandidateLine)
        bullishCisdCandidateLine := line.new(
            x1 = bullishCisdCandidateBar,
            y1 = bullishCisdCandidateLevel,
            x2 = bullishCisdCandidateBar + cisdConfirmationBars,
            y2 = bullishCisdCandidateLevel,
            xloc = xloc.bar_index,
            extend = extend.none,
            color = color.new(bullishColor, 34),
            style = line.style_dashed,
            width = 1
        )
    else
        line.set_xy1(
            bullishCisdCandidateLine,
            bullishCisdCandidateBar,
            bullishCisdCandidateLevel
        )
        line.set_xy2(
            bullishCisdCandidateLine,
            bullishCisdCandidateBar + cisdConfirmationBars,
            bullishCisdCandidateLevel
        )
else if not na(bullishCisdCandidateLine)
    line.delete(bullishCisdCandidateLine)
    bullishCisdCandidateLine := na

if (
    showCisdLevels and
    not na(bearishCisdCandidateLevel) and
    not na(bearishCisdCandidateBar)
)
    if na(bearishCisdCandidateLine)
        bearishCisdCandidateLine := line.new(
            x1 = bearishCisdCandidateBar,
            y1 = bearishCisdCandidateLevel,
            x2 = bearishCisdCandidateBar + cisdConfirmationBars,
            y2 = bearishCisdCandidateLevel,
            xloc = xloc.bar_index,
            extend = extend.none,
            color = color.new(bearishColor, 34),
            style = line.style_dashed,
            width = 1
        )
    else
        line.set_xy1(
            bearishCisdCandidateLine,
            bearishCisdCandidateBar,
            bearishCisdCandidateLevel
        )
        line.set_xy2(
            bearishCisdCandidateLine,
            bearishCisdCandidateBar + cisdConfirmationBars,
            bearishCisdCandidateLevel
        )
else if not na(bearishCisdCandidateLine)
    line.delete(bearishCisdCandidateLine)
    bearishCisdCandidateLine := na

if showCisdLevels and cisdEventPulse != 0
    line.new(
        x1 = latestCisdEventBar,
        y1 = latestCisdLevel,
        x2 = latestCisdEventBar + cisdContextBars,
        y2 = latestCisdLevel,
        xloc = xloc.bar_index,
        extend = extend.none,
        color = f_state_color(latestCisdDirection),
        style = line.style_solid,
        width = cisdQuality == 3 ? 2 : 1
    )

if showCisdEvents and cisdEventPulse != 0
    label.new(
        x = latestCisdEventBar,
        y = latestCisdLevel,
        text = f_state_short(latestCisdDirection) + " CISD",
        xloc = xloc.bar_index,
        style = latestCisdDirection == 1 ?
            label.style_label_down :
            label.style_label_up,
        color = color.new(f_state_color(latestCisdDirection), 12),
        textcolor = panelColor,
        size = size.tiny
    )

var box displacementCandidateBox = na
if (
    showDisplacementZones and
    displacementCandidateActive and
    not na(displacementCandidateHigh) and
    not na(displacementCandidateLow)
)
    color displacementCandidateColor = f_state_color(
        displacementCandidateDirection
    )
    if na(displacementCandidateBox)
        displacementCandidateBox := box.new(
