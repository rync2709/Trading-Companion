var table biasPanel = table.new(
    position.top_right,
    2,
    10,
    frame_color = panelBorderColor,
    frame_width = 1,
    border_color = panelBorderColor,
    border_width = 1
)

if barstate.isfirst
    table.merge_cells(biasPanel, 0, 0, 1, 0)

if barstate.islast
    table.cell(
        biasPanel,
        0,
        0,
        "TRADING OS · HTF v0.11.0",
        bgcolor = panelColor,
        text_color = textColor,
        text_halign = text.align_left,
        text_size = dashboardTextSize
    )
    table.cell(
        biasPanel,
        0,
        1,
        "HTF",
        bgcolor = panelColor,
        text_color = mutedTextColor,
        text_halign = text.align_left,
        text_size = dashboardTextSize
    )
    table.cell(
        biasPanel,
        1,
        1,
        (
            f_timeframe_label(primaryTimeframe) + " " +
            f_state_short(primaryState) + " · " +
            f_timeframe_label(secondaryTimeframe) + " " +
            f_state_short(secondaryState)
        ),
        bgcolor = panelColor,
        text_color = textColor,
        text_size = dashboardTextSize
    )
    table.cell(
        biasPanel,
        0,
        2,
        "Bias",
        bgcolor = panelColor,
        text_color = mutedTextColor,
        text_halign = text.align_left,
        text_size = dashboardTextSize
    )
    table.cell(
        biasPanel,
        1,
        2,
        f_state_text(combinedState) + " · " + confidence,
        bgcolor = color.new(f_state_color(combinedState), 84),
        text_color = f_state_color(combinedState),
        text_size = dashboardTextSize
    )
    table.cell(
        biasPanel,
        0,
        3,
        "Context",
        bgcolor = panelColor,
        text_color = mutedTextColor,
        text_halign = text.align_left,
        text_size = dashboardTextSize
    )
    table.cell(
        biasPanel,
        1,
        3,
        alignmentState,
        bgcolor = color.new(alignmentColor, 86),
        text_color = alignmentColor,
        text_size = dashboardTextSize
    )
    table.cell(
        biasPanel,
        0,
        4,
        "POI",
        bgcolor = panelColor,
        text_color = mutedTextColor,
        text_halign = text.align_left,
        text_size = dashboardTextSize
    )
    table.cell(
        biasPanel,
        1,
        4,
        (
            poiActive ?
            poiTimeframe + " " + f_state_short(poiDirection) + " FVG" :
            "NONE"
        ),
        bgcolor = poiInteractionActive ?
            color.new(f_state_color(poiDirection), 84) :
            panelColor,
        text_color = poiInteractionActive ?
            f_state_color(poiDirection) :
            neutralColor,
        text_size = dashboardTextSize
    )
    table.cell(
        biasPanel,
        0,
        5,
        dashboardStatusLabel,
        bgcolor = panelColor,
        text_color = mutedTextColor,
        text_halign = text.align_left,
        text_size = dashboardTextSize
    )
    table.cell(
        biasPanel,
        1,
        5,
        dashboardStatusValue,
        bgcolor = dashboardStatusActive ?
            color.new(dashboardStatusColor, 86) :
            panelColor,
        text_color = dashboardStatusColor,
        text_size = dashboardTextSize
    )
    table.cell(
        biasPanel,
        0,
        6,
        "Liquidity",
        bgcolor = panelColor,
        text_color = mutedTextColor,
        text_halign = text.align_left,
        text_size = dashboardTextSize
    )
    table.cell(
        biasPanel,
        1,
        6,
        liquidityState,
        bgcolor = pdhSweptToday or pdlSweptToday ?
            color.new(liquidityStateColor, 86) :
            panelColor,
        text_color = liquidityStateColor,
        text_size = dashboardTextSize
    )
    table.cell(
        biasPanel,
        0,
        7,
        "Structure",
        bgcolor = panelColor,
        text_color = mutedTextColor,
        text_halign = text.align_left,
        text_size = dashboardTextSize
    )
    table.cell(
        biasPanel,
        1,
