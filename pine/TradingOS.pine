        )
else if not na(displacementCandidateBox)
    box.delete(displacementCandidateBox)
    displacementCandidateBox := na

if (
    showDisplacementZones and
    displacementEventPulse != 0 and
    not na(latestDisplacementHigh) and
    not na(latestDisplacementLow)
)
    color displacementEventColor = f_state_color(
        latestDisplacementDirection
    )
    box.new(
        left = latestDisplacementExpansionBar,
        top = latestDisplacementHigh,
        right = latestDisplacementEventBar + displacementContextBars,
        bottom = latestDisplacementLow,
        xloc = xloc.bar_index,
        extend = extend.none,
        border_color = color.new(displacementEventColor, 12),
        border_width = latestDisplacementQuality == 3 ? 2 : 1,
        bgcolor = color.new(displacementEventColor, 89),
        text = (
            f_state_short(latestDisplacementDirection) + " DISP · " +
            f_quality_text(latestDisplacementQuality)
        ),
        text_color = displacementEventColor,
        text_size = size.tiny,
        text_halign = text.align_left,
        text_valign = text.align_top
    )

if showDisplacementEvents and displacementEventPulse != 0
    label.new(
        x = latestDisplacementEventBar,
        y = latestDisplacementDirection == 1 ?
            latestDisplacementHigh :
            latestDisplacementLow,
        text = "DISP " + f_quality_text(latestDisplacementQuality),
        xloc = xloc.bar_index,
        style = latestDisplacementDirection == 1 ?
            label.style_label_down :
            label.style_label_up,
        color = color.new(f_state_color(latestDisplacementDirection), 12),
        textcolor = panelColor,
        size = size.tiny
    )

var box entryFvgBox = na
if barstate.islast
    if (
        showEntryFvg and
        entryFvgExists and
        not na(entryFvgStartTime)
    )
        color entryFvgColor = (
            entryFvgStatus == 3 ?
            neutralColor :
            f_state_color(entryFvgDirection)
        )
        int entryFvgRightTime = (
            entryFvgStatus == 3 and not na(entryFvgFilledTime) ?
            entryFvgFilledTime :
            time
        )
        string entryFvgText = (
            f_timeframe_label(timeframe.period) + " " +
            f_state_short(entryFvgDirection) + " ENTRY FVG · " +
            f_fvg_status_text(entryFvgStatus)
        )
        if na(entryFvgBox)
            entryFvgBox := box.new(
                left = entryFvgStartTime,
                top = entryFvgTop,
                right = entryFvgRightTime,
                bottom = entryFvgBottom,
                xloc = xloc.bar_time,
                extend = entryFvgActive ? extend.right : extend.none,
                border_color = color.new(entryFvgColor, 8),
                border_width = 2,
                bgcolor = color.new(entryFvgColor, 86),
                text = entryFvgText,
                text_color = entryFvgColor,
                text_size = size.tiny,
                text_halign = text.align_left,
                text_valign = text.align_top
            )
        else
            box.set_left(entryFvgBox, entryFvgStartTime)
            box.set_top(entryFvgBox, entryFvgTop)
            box.set_right(entryFvgBox, entryFvgRightTime)
            box.set_bottom(entryFvgBox, entryFvgBottom)
            box.set_extend(
                entryFvgBox,
                entryFvgActive ? extend.right : extend.none
            )
            box.set_border_color(
                entryFvgBox,
                color.new(entryFvgColor, 8)
            )
            box.set_bgcolor(
                entryFvgBox,
                color.new(entryFvgColor, 86)
            )
            box.set_text(entryFvgBox, entryFvgText)
            box.set_text_color(entryFvgBox, entryFvgColor)
    else if not na(entryFvgBox)
        box.delete(entryFvgBox)
        entryFvgBox := na

if showEntryFvgEvents and entryFvgCreatedPulse != 0
    label.new(
        x = entryFvgCreatedBar,
        y = entryFvgDirection == 1 ? entryFvgBottom : entryFvgTop,
        text = "ENTRY FVG",
        xloc = xloc.bar_index,
        style = entryFvgDirection == 1 ?
            label.style_label_up :
            label.style_label_down,
        color = color.new(f_state_color(entryFvgDirection), 12),
        textcolor = panelColor,
        size = size.tiny
    )

if showEntryFvgEvents and entryFvgRetracePulse != 0
    label.new(
        x = bar_index,
        y = entryFvgRetracePulse == 1 ? entryFvgTop : entryFvgBottom,
        text = "FVG RETRACE",
        xloc = xloc.bar_index,
        style = entryFvgRetracePulse == 1 ?
            label.style_label_down :
            label.style_label_up,
        color = color.new(warningColor, 12),
        textcolor = panelColor,
        size = size.tiny
    )

if showEntryFvgEvents and entryFvgFilledPulse != 0
    label.new(
        x = bar_index,
        y = entryFvgFilledPulse == 1 ? entryFvgBottom : entryFvgTop,
        text = "FVG FILLED",
        xloc = xloc.bar_index,
        style = entryFvgFilledPulse == 1 ?
            label.style_label_up :
            label.style_label_down,
        color = color.new(neutralColor, 12),
        textcolor = panelColor,
        size = size.tiny
    )

var line plannedEntryLine = na
var line plannedStopLine = na
var line plannedTargetLine = na
var label plannedEntryLabel = na
var label plannedStopLabel = na
var label plannedTargetLabel = na

if barstate.islast
    if (
        showRiskPlan and
        riskPlanAvailable and
        not na(riskPlanStartTime)
    )
        if na(plannedEntryLine)
            plannedEntryLine := line.new(
                x1 = riskPlanStartTime,
                y1 = plannedEntry,
                x2 = time,
                y2 = plannedEntry,
                xloc = xloc.bar_time,
                extend = extend.right,
                color = warningColor,
                style = line.style_solid,
                width = 1
            )
            plannedStopLine := line.new(
                x1 = riskPlanStartTime,
                y1 = plannedStop,
                x2 = time,
                y2 = plannedStop,
                xloc = xloc.bar_time,
                extend = extend.right,
                color = bearishColor,
                style = line.style_dashed,
                width = 1
            )
            plannedTargetLine := line.new(
                x1 = riskPlanStartTime,
                y1 = plannedTarget,
                x2 = time,
                y2 = plannedTarget,
                xloc = xloc.bar_time,
                extend = extend.right,
                color = bullishColor,
                style = line.style_dashed,
                width = 1
            )
            plannedEntryLabel := label.new(
                x = bar_index + 1,
                y = plannedEntry,
                text = "ENTRY " + str.tostring(plannedEntry, format.mintick),
                xloc = xloc.bar_index,
                style = label.style_label_left,
                color = color.new(warningColor, 12),
                textcolor = panelColor,
                size = size.tiny
            )
            plannedStopLabel := label.new(
                x = bar_index + 1,
                y = plannedStop,
                text = "SL " + str.tostring(plannedStop, format.mintick),
                xloc = xloc.bar_index,
                style = label.style_label_left,
                color = color.new(bearishColor, 12),
                textcolor = panelColor,
                size = size.tiny
            )
            plannedTargetLabel := label.new(
                x = bar_index + 1,
                y = plannedTarget,
                text = (
                    "TP " + str.tostring(plannedTarget, format.mintick) +
                    " · " + str.tostring(plannedRr, "#.##") + "R"
                ),
                xloc = xloc.bar_index,
                style = label.style_label_left,
                color = color.new(bullishColor, 12),
                textcolor = panelColor,
                size = size.tiny
            )
        else
            line.set_xy1(
                plannedEntryLine,
                riskPlanStartTime,
                plannedEntry
            )
            line.set_xy2(plannedEntryLine, time, plannedEntry)
            line.set_xy1(plannedStopLine, riskPlanStartTime, plannedStop)
            line.set_xy2(plannedStopLine, time, plannedStop)
            line.set_xy1(
                plannedTargetLine,
                riskPlanStartTime,
                plannedTarget
            )
            line.set_xy2(plannedTargetLine, time, plannedTarget)
            label.set_xy(plannedEntryLabel, bar_index + 1, plannedEntry)
            label.set_text(
                plannedEntryLabel,
                "ENTRY " + str.tostring(plannedEntry, format.mintick)
            )
            label.set_xy(plannedStopLabel, bar_index + 1, plannedStop)
            label.set_text(
                plannedStopLabel,
                "SL " + str.tostring(plannedStop, format.mintick)
            )
            label.set_xy(plannedTargetLabel, bar_index + 1, plannedTarget)
            label.set_text(
                plannedTargetLabel,
                (
                    "TP " + str.tostring(plannedTarget, format.mintick) +
                    " · " + str.tostring(plannedRr, "#.##") + "R"
                )
            )
    else
        if not na(plannedEntryLine)
            line.delete(plannedEntryLine)
            plannedEntryLine := na
        if not na(plannedStopLine)
            line.delete(plannedStopLine)
            plannedStopLine := na
        if not na(plannedTargetLine)
            line.delete(plannedTargetLine)
            plannedTargetLine := na
        if not na(plannedEntryLabel)
            label.delete(plannedEntryLabel)
            plannedEntryLabel := na
        if not na(plannedStopLabel)
            label.delete(plannedStopLabel)
            plannedStopLabel := na
        if not na(plannedTargetLabel)
            label.delete(plannedTargetLabel)
            plannedTargetLabel := na

