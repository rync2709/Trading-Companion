//@version=6
indicator(
    "Trading OS - HTF Context",
    shorttitle = "Trading OS Context",
    overlay = true,
    max_lines_count = 300,
    max_boxes_count = 100,
    max_labels_count = 300
)

// Trading OS Pine Track v0.11.0-alpha
// Modules: confirmed 4H/1H Bias, aligned HTF FVG and Order Block context,
// daily liquidity, confirmed execution-chart BOS/CHOCH/MSS, strict CISD
// context, execution-chart displacement with follow-through, Entry FVG
// confirmation, an automated setup score, a locked Entry/Risk planning
// baseline, and confirmed-bar event alerts. Full chart context is enabled by
// default. This indicator remains decision support and does not generate
// Buy/Sell signals.

