//@version=6
indicator(
    "Trading OS - HTF Context",
    shorttitle = "Trading OS Context",
    overlay = true,
    max_lines_count = 10
)

// Trading OS Pine Track v0.5.2-alpha
// Modules: confirmed 4H/1H Bias, aligned HTF FVG candidates, daily liquidity,
// confirmed execution-chart BOS/CHOCH/MSS, and strict CISD context.
// This indicator is decision support. It does not generate Buy/Sell signals.

string primaryTimeframe = input.timeframe("240", "Primary HTF", group = "HTF Bias")
string secondaryTimeframe = input.timeframe("60", "Secondary HTF", group = "HTF Bias")
int swingLength = input.int(
    3,
    "Confirmed swing length",
    minval = 1,
    maxval = 20,
    tooltip = "A pivot is confirmed after this many bars on both sides.",
    group = "HTF Bias"
)
int structureSwingLength = input.int(
    3,
    "Execution swing length",
    minval = 1,
    maxval = 20,
    tooltip = "Confirms execution-chart swing levels after this many bars on both sides.",
    group = "Market Structure"
)
int structureContextBars = input.int(
    20,
    "Structure context bars",
    minval = 1,
    maxval = 200,
    tooltip = "Maximum chart bars used to connect a liquidity sweep to MSS and keep the latest structure event active in the Dashboard.",
    group = "Market Structure"
)
int cisdMinimumDeliveryCandles = input.int(
    3,
    "Minimum delivery candles",
    minval = 1,
    maxval = 20,
    tooltip = "Minimum consecutive directional candles required to arm a CISD level.",
    group = "CISD"
)
int cisdMaximumDeliveryCandles = input.int(
    8,
    "Maximum delivery candles",
    minval = 1,
    maxval = 50,
    tooltip = "Maximum consecutive candles retained when a delivery leg is longer.",
    group = "CISD"
)
int cisdAtrLength = input.int(
    14,
    "ATR length",
    minval = 1,
    maxval = 200,
    group = "CISD"
)
float cisdMinimumLegAtr = input.float(
    0.8,
    "Minimum delivery leg, ATR",
    minval = 0.0,
    maxval = 10.0,
    step = 0.1,
    tooltip = "Minimum high-to-low range of the delivery leg relative to ATR.",
    group = "CISD"
)
int cisdConfirmationBars = input.int(
    8,
    "Confirmation bars",
    minval = 1,
    maxval = 100,
    tooltip = "Maximum bars allowed for price to close through an armed CISD level.",
    group = "CISD"
)
int cisdContextBars = input.int(
    20,
    "CISD context bars",
    minval = 1,
    maxval = 200,
    tooltip = "Number of chart bars that the latest confirmed CISD remains active.",
    group = "CISD"
)
bool showCisdLevels = input.bool(
    true,
    "Show CISD levels",
    tooltip = "Draws armed candidate levels and the latest confirmed CISD level for the current chart timeframe.",
    group = "CISD"
)
bool showBiasBackground = input.bool(
    true,
    "Show bias background",
    group = "Display"
)
string dashboardSizeInput = input.string(
    "Small",
    "Dashboard text size",
    options = ["Tiny", "Small", "Normal"],
    group = "Display"
)
string dashboardTextSize = (
    dashboardSizeInput == "Tiny" ? size.tiny :
    dashboardSizeInput == "Normal" ? size.normal :
    size.small
)

color bullishColor = color.rgb(82, 212, 147)
color bearishColor = color.rgb(239, 105, 118)
color neutralColor = color.rgb(142, 151, 154)
color warningColor = color.rgb(237, 189, 91)
color panelColor = color.rgb(18, 23, 24)
color panelBorderColor = color.rgb(55, 64, 66)
color textColor = color.rgb(238, 242, 241)
color mutedTextColor = color.rgb(161, 170, 172)

f_structure_state(int length) =>
    float pivotHigh = ta.pivothigh(high, length, length)
    float pivotLow = ta.pivotlow(low, length, length)
    var float latestHigh = na
    var float previousHigh = na
    var float latestLow = na
    var float previousLow = na

    if not na(pivotHigh)
        previousHigh := latestHigh
        latestHigh := pivotHigh

    if not na(pivotLow)
        previousLow := latestLow
        latestLow := pivotLow

    bool hasStructure = (
        not na(latestHigh) and
        not na(previousHigh) and
        not na(latestLow) and
        not na(previousLow)
    )
    bool bullishStructure = (
        hasStructure and
        latestHigh > previousHigh and
        latestLow > previousLow
    )
    bool bearishStructure = (
        hasStructure and
        latestHigh < previousHigh and
        latestLow < previousLow
    )

    bullishStructure ? 1 : bearishStructure ? -1 : 0

f_state_text(int state) =>
    state == 1 ? "BULLISH" : state == -1 ? "BEARISH" : "NEUTRAL"

f_state_short(int state) =>
    state == 1 ? "BULL" : state == -1 ? "BEAR" : "NEUTRAL"

f_state_color(int state) =>
    state == 1 ? bullishColor : state == -1 ? bearishColor : neutralColor

f_fvg_status_text(int status) =>
    status == 1 ? "FRESH" :
     status == 2 ? "PARTIAL" :
     status == 3 ? "FILLED" :
     "NONE"

f_fvg_state() =>
    var float bullishTop = na
    var float bullishBottom = na
    var int bullishStart = na
    var int bullishStatus = 0
    var float bearishTop = na
    var float bearishBottom = na
    var int bearishStart = na
    var int bearishStatus = 0

    // Every expression uses completed HTF bars. Bar [1] is the latest
    // completed candle and bar [3] is the first candle in the FVG pattern.
    bool bullishCreated = low[1] > high[3]
    bool bearishCreated = high[1] < low[3]

    if bullishCreated
        bullishTop := low[1]
        bullishBottom := high[3]
        bullishStart := time[3]
        bullishStatus := 1
    else if bullishStatus == 1 or bullishStatus == 2
        if low[1] <= bullishBottom
            bullishStatus := 3
        else if low[1] < bullishTop
            bullishStatus := 2

    if bearishCreated
        bearishTop := low[3]
        bearishBottom := high[1]
        bearishStart := time[3]
        bearishStatus := 1
    else if bearishStatus == 1 or bearishStatus == 2
        if high[1] >= bearishTop
            bearishStatus := 3
        else if high[1] > bearishBottom
            bearishStatus := 2

    [bullishTop, bullishBottom, bullishStart, bullishStatus, bearishTop, bearishBottom, bearishStart, bearishStatus]

f_fvg_active(int status) =>
    status == 1 or status == 2

f_structure_event_text(int eventCode) =>
    eventCode == 1 ? "BOS" :
     eventCode == 2 ? "CHOCH" :
     eventCode == 3 ? "MSS" :
     "WAIT"

f_quality_text(int quality) =>
    quality == 3 ? "STRONG" :
     quality == 2 ? "MEDIUM" :
     quality == 1 ? "WEAK" :
     "WAIT"

f_execution_structure(int length, bool recentPdhSweep, bool recentPdlSweep) =>
    float pivotHigh = ta.pivothigh(high, length, length)
    float pivotLow = ta.pivotlow(low, length, length)
    var float latestSwingHigh = na
    var float latestSwingLow = na
    var bool latestHighBroken = false
    var bool latestLowBroken = false
    var int trendState = 0
    var int latestEvent = 0
    var int latestDirection = 0
    var float latestBreakLevel = na
    var int latestEventBar = na

    bool bullishBreak = (
        barstate.isconfirmed and
        not latestHighBroken and
        not na(latestSwingHigh) and
        close > latestSwingHigh and
        close[1] <= latestSwingHigh
    )
    bool bearishBreak = (
        barstate.isconfirmed and
        not latestLowBroken and
        not na(latestSwingLow) and
        close < latestSwingLow and
        close[1] >= latestSwingLow
    )
    int eventPulse = 0

    if bullishBreak
        eventPulse := trendState == -1 ? (recentPdlSweep ? 3 : 2) : 1
        latestEvent := eventPulse
        latestDirection := 1
        latestBreakLevel := latestSwingHigh
        latestEventBar := bar_index
        trendState := 1
        latestHighBroken := true
    else if bearishBreak
        eventPulse := trendState == 1 ? (recentPdhSweep ? 3 : 2) : 1
        latestEvent := eventPulse
        latestDirection := -1
        latestBreakLevel := latestSwingLow
        latestEventBar := bar_index
        trendState := -1
        latestLowBroken := true

    if not na(pivotHigh)
        latestSwingHigh := pivotHigh
        latestHighBroken := false

    if not na(pivotLow)
        latestSwingLow := pivotLow
        latestLowBroken := false

    [eventPulse, latestEvent, latestDirection, trendState, latestBreakLevel, latestEventBar, latestSwingHigh, latestSwingLow]

f_cisd_state(
    int minimumDeliveryCandles,
    int maximumDeliveryCandles,
    int atrLength,
    float minimumLegAtr,
    int confirmationBars
) =>
    int requiredCandles = math.min(minimumDeliveryCandles, maximumDeliveryCandles)
    float atrValue = ta.atr(atrLength)
    float rollingHigh = ta.highest(high, maximumDeliveryCandles)
    float rollingLow = ta.lowest(low, maximumDeliveryCandles)
    bool bullishCandle = close > open
    bool bearishCandle = close < open
    var int bearishRunCount = 0
    var float bearishRunOpen = na
    var float bearishRunHigh = na
    var float bearishRunLow = na
    var int bullishRunCount = 0
    var float bullishRunOpen = na
    var float bullishRunHigh = na
    var float bullishRunLow = na
    var bool bullishCandidateActive = false
    var float bullishCandidateLevel = na
    var int bullishCandidateBar = na
    var int bullishCandidateLegCount = 0
    var float bullishCandidateLegRange = na
    var bool bearishCandidateActive = false
    var float bearishCandidateLevel = na
    var int bearishCandidateBar = na
    var int bearishCandidateLegCount = 0
    var float bearishCandidateLegRange = na
    var int latestDirection = 0
    var float latestLevel = na
    var int latestEventBar = na
    var int latestLegCount = 0
    var float latestLegRange = na

    if not bearishCandle and bearishRunCount > 0
        float bearishLegRange = bearishRunHigh - bearishRunLow
        bool bearishLegQualified = (
            bearishRunCount >= requiredCandles and
            bearishLegRange >= atrValue * minimumLegAtr
        )
        if bearishLegQualified
            bullishCandidateActive := true
            bullishCandidateLevel := bearishRunOpen
            bullishCandidateBar := bar_index
            bullishCandidateLegCount := bearishRunCount
            bullishCandidateLegRange := bearishLegRange
        bearishRunCount := 0
        bearishRunOpen := na
        bearishRunHigh := na
        bearishRunLow := na

    if not bullishCandle and bullishRunCount > 0
        float bullishLegRange = bullishRunHigh - bullishRunLow
        bool bullishLegQualified = (
            bullishRunCount >= requiredCandles and
            bullishLegRange >= atrValue * minimumLegAtr
        )
        if bullishLegQualified
            bearishCandidateActive := true
            bearishCandidateLevel := bullishRunOpen
            bearishCandidateBar := bar_index
            bearishCandidateLegCount := bullishRunCount
            bearishCandidateLegRange := bullishLegRange
        bullishRunCount := 0
        bullishRunOpen := na
        bullishRunHigh := na
        bullishRunLow := na

    if bearishCandle
        if bearishRunCount == 0
            bearishRunCount := 1
            bearishRunOpen := open
            bearishRunHigh := high
            bearishRunLow := low
        else
            bearishRunCount += 1
            bearishRunHigh := math.max(bearishRunHigh, high)
            bearishRunLow := math.min(bearishRunLow, low)
            if bearishRunCount > maximumDeliveryCandles
                bearishRunCount := maximumDeliveryCandles
                bearishRunOpen := open[maximumDeliveryCandles - 1]
                bearishRunHigh := rollingHigh
                bearishRunLow := rollingLow

    if bullishCandle
        if bullishRunCount == 0
            bullishRunCount := 1
            bullishRunOpen := open
            bullishRunHigh := high
            bullishRunLow := low
        else
            bullishRunCount += 1
            bullishRunHigh := math.max(bullishRunHigh, high)
            bullishRunLow := math.min(bullishRunLow, low)
            if bullishRunCount > maximumDeliveryCandles
                bullishRunCount := maximumDeliveryCandles
                bullishRunOpen := open[maximumDeliveryCandles - 1]
                bullishRunHigh := rollingHigh
                bullishRunLow := rollingLow

    if (
        bullishCandidateActive and
        bar_index - bullishCandidateBar > confirmationBars
    )
        bullishCandidateActive := false
        bullishCandidateLevel := na

    if (
        bearishCandidateActive and
        bar_index - bearishCandidateBar > confirmationBars
    )
        bearishCandidateActive := false
        bearishCandidateLevel := na

    bool bullishEvent = (
        barstate.isconfirmed and
        bullishCandle and
        bullishCandidateActive and
        close > bullishCandidateLevel
    )
    bool bearishEvent = (
        barstate.isconfirmed and
        bearishCandle and
        bearishCandidateActive and
        close < bearishCandidateLevel
    )
    int eventPulse = 0

    if bullishEvent
        eventPulse := 1
        latestDirection := 1
        latestLevel := bullishCandidateLevel
        latestEventBar := bar_index
        latestLegCount := bullishCandidateLegCount
        latestLegRange := bullishCandidateLegRange
        bullishCandidateActive := false
        bullishCandidateLevel := na
    else if bearishEvent
        eventPulse := -1
        latestDirection := -1
        latestLevel := bearishCandidateLevel
        latestEventBar := bar_index
        latestLegCount := bearishCandidateLegCount
        latestLegRange := bearishCandidateLegRange
        bearishCandidateActive := false
        bearishCandidateLevel := na

    [eventPulse, latestDirection, latestLevel, latestEventBar, latestLegCount, latestLegRange, bullishCandidateActive ? bullishCandidateLevel : na, bullishCandidateActive ? bullishCandidateBar : na, bearishCandidateActive ? bearishCandidateLevel : na, bearishCandidateActive ? bearishCandidateBar : na]

f_timeframe_label(string value) =>
    value == "240" ? "4H" :
     value == "60" ? "1H" :
     value == "15" ? "15M" :
     value == "5" ? "5M" :
     value

// A one-bar offset with lookahead_on returns the last completed HTF state.
// This avoids using a still-forming higher-timeframe bar.
int primaryState = request.security(
    syminfo.tickerid,
    primaryTimeframe,
    f_structure_state(swingLength)[1],
    gaps = barmerge.gaps_off,
    lookahead = barmerge.lookahead_on
)
int secondaryState = request.security(
    syminfo.tickerid,
    secondaryTimeframe,
    f_structure_state(swingLength)[1],
    gaps = barmerge.gaps_off,
    lookahead = barmerge.lookahead_on
)

[primaryBullTop, primaryBullBottom, primaryBullStart, primaryBullStatus, primaryBearTop, primaryBearBottom, primaryBearStart, primaryBearStatus] = request.security(
    syminfo.tickerid,
    primaryTimeframe,
    f_fvg_state(),
    gaps = barmerge.gaps_off,
    lookahead = barmerge.lookahead_on
)
[secondaryBullTop, secondaryBullBottom, secondaryBullStart, secondaryBullStatus, secondaryBearTop, secondaryBearBottom, secondaryBearStart, secondaryBearStatus] = request.security(
    syminfo.tickerid,
    secondaryTimeframe,
    f_fvg_state(),
    gaps = barmerge.gaps_off,
    lookahead = barmerge.lookahead_on
)
[previousDayHigh, previousDayLow] = request.security(
    syminfo.tickerid,
    "1D",
    [high[1], low[1]],
    gaps = barmerge.gaps_off,
    lookahead = barmerge.lookahead_on
)

float primarySeconds = timeframe.in_seconds(primaryTimeframe)
float secondarySeconds = timeframe.in_seconds(secondaryTimeframe)
bool timeframeOrderValid = primarySeconds > secondarySeconds
bool conflict = (
    timeframeOrderValid and
    primaryState != 0 and
    secondaryState != 0 and
    primaryState != secondaryState
)
bool aligned = (
    timeframeOrderValid and
    primaryState != 0 and
    primaryState == secondaryState
)
bool primaryOnly = (
    timeframeOrderValid and
    primaryState != 0 and
    secondaryState == 0
)

int combinedState = aligned ? primaryState : primaryOnly ? primaryState : 0
string confidence = aligned ? "HIGH" : primaryOnly ? "MEDIUM" : "LOW"
string alignmentState = (
    not timeframeOrderValid ? "INVALID TF ORDER" :
    conflict ? "CONFLICT" :
    aligned ? "ALIGNED" :
    primaryOnly ? "PRIMARY ONLY" :
    "WAIT"
)
color alignmentColor = (
    not timeframeOrderValid or conflict ? warningColor :
    aligned ? bullishColor :
    primaryOnly ? warningColor :
    neutralColor
)

bool primaryBullAvailable = f_fvg_active(primaryBullStatus)
bool primaryBearAvailable = f_fvg_active(primaryBearStatus)
bool secondaryBullAvailable = f_fvg_active(secondaryBullStatus)
bool secondaryBearAvailable = f_fvg_active(secondaryBearStatus)
bool usePrimaryBull = combinedState == 1 and primaryBullAvailable
bool useSecondaryBull = (
    combinedState == 1 and
    not primaryBullAvailable and
    secondaryBullAvailable
)
bool usePrimaryBear = combinedState == -1 and primaryBearAvailable
bool useSecondaryBear = (
    combinedState == -1 and
    not primaryBearAvailable and
    secondaryBearAvailable
)

int poiDirection = (
    usePrimaryBull or useSecondaryBull ? 1 :
    usePrimaryBear or useSecondaryBear ? -1 :
    0
)
float poiTop = (
    usePrimaryBull ? primaryBullTop :
    useSecondaryBull ? secondaryBullTop :
    usePrimaryBear ? primaryBearTop :
    useSecondaryBear ? secondaryBearTop :
    na
)
float poiBottom = (
    usePrimaryBull ? primaryBullBottom :
    useSecondaryBull ? secondaryBullBottom :
    usePrimaryBear ? primaryBearBottom :
    useSecondaryBear ? secondaryBearBottom :
    na
)
int poiStart = (
    usePrimaryBull ? primaryBullStart :
    useSecondaryBull ? secondaryBullStart :
    usePrimaryBear ? primaryBearStart :
    useSecondaryBear ? secondaryBearStart :
    na
)
int poiStatus = (
    usePrimaryBull ? primaryBullStatus :
    useSecondaryBull ? secondaryBullStatus :
    usePrimaryBear ? primaryBearStatus :
    useSecondaryBear ? secondaryBearStatus :
    0
)
string poiTimeframe = (
    usePrimaryBull or usePrimaryBear ? f_timeframe_label(primaryTimeframe) :
    useSecondaryBull or useSecondaryBear ? f_timeframe_label(secondaryTimeframe) :
    "--"
)
bool poiActive = poiDirection != 0 and f_fvg_active(poiStatus)
bool priceInsidePoi = (
    poiActive and
    close <= poiTop and
    close >= poiBottom
)
bool priceTouchesPoi = (
    poiActive and
    high >= poiBottom and
    low <= poiTop
)
bool poiInteractionActive = priceInsidePoi or priceTouchesPoi
string poiLocation = (
    priceInsidePoi ? "IN ZONE" :
    priceTouchesPoi ? "TOUCH" :
    poiActive ? "AWAY" :
    "--"
)
bool newExchangeDay = ta.change(time("1D")) != 0
var bool pdhSweptToday = false
var bool pdlSweptToday = false

if newExchangeDay
    pdhSweptToday := false
    pdlSweptToday := false

bool pdhSweepEvent = (
    barstate.isconfirmed and
    not pdhSweptToday and
    not na(previousDayHigh) and
    high > previousDayHigh and
    close < previousDayHigh
)
bool pdlSweepEvent = (
    barstate.isconfirmed and
    not pdlSweptToday and
    not na(previousDayLow) and
    low < previousDayLow and
    close > previousDayLow
)

if pdhSweepEvent
    pdhSweptToday := true
if pdlSweepEvent
    pdlSweptToday := true

int barsSincePdhSweep = ta.barssince(pdhSweepEvent)
int barsSincePdlSweep = ta.barssince(pdlSweepEvent)
bool recentPdhSweep = (
    not na(barsSincePdhSweep) and
    barsSincePdhSweep <= structureContextBars
)
bool recentPdlSweep = (
    not na(barsSincePdlSweep) and
    barsSincePdlSweep <= structureContextBars
)

[structureEventPulse, latestStructureEvent, latestStructureDirection, executionTrendState, latestStructureLevel, latestStructureEventBar, latestExecutionSwingHigh, latestExecutionSwingLow] = f_execution_structure(
    structureSwingLength,
    recentPdhSweep,
    recentPdlSweep
)

bool structureEventActive = (
    latestStructureEvent != 0 and
    not na(latestStructureEventBar) and
    bar_index - latestStructureEventBar <= structureContextBars
)
bool structureAligned = (
    structureEventActive and
    combinedState != 0 and
    latestStructureDirection == combinedState
)
string structureState = (
    structureEventActive ?
    f_structure_event_text(latestStructureEvent) + " " +
    f_state_short(latestStructureDirection) :
    "WAIT"
)
color structureStateColor = (
    not structureEventActive ? neutralColor :
    structureAligned ? f_state_color(latestStructureDirection) :
    warningColor
)

[cisdEventPulse, latestCisdDirection, latestCisdLevel, latestCisdEventBar, latestCisdLegCount, latestCisdLegRange, bullishCisdCandidateLevel, bullishCisdCandidateBar, bearishCisdCandidateLevel, bearishCisdCandidateBar] = f_cisd_state(
    cisdMinimumDeliveryCandles,
    cisdMaximumDeliveryCandles,
    cisdAtrLength,
    cisdMinimumLegAtr,
    cisdConfirmationBars
)

bool cisdEventActive = (
    latestCisdDirection != 0 and
    not na(latestCisdEventBar) and
    bar_index - latestCisdEventBar <= cisdContextBars
)
bool cisdAligned = (
    cisdEventActive and
    combinedState != 0 and
    latestCisdDirection == combinedState
)
bool cisdMatchingSweep = (
    latestCisdDirection == 1 ? recentPdlSweep :
    latestCisdDirection == -1 ? recentPdhSweep :
    false
)
bool cisdMatchingStructure = (
    structureEventActive and
    latestCisdDirection == latestStructureDirection
)
bool cisdMatchingPoi = (
    poiInteractionActive and
    latestCisdDirection == poiDirection
)
bool cisdContextAvailable = (
    cisdMatchingSweep or
    cisdMatchingStructure or
    cisdMatchingPoi
)
int cisdQuality = (
    not cisdEventActive ? 0 :
    (
        cisdAligned and
        cisdMatchingStructure and
        (cisdMatchingSweep or cisdMatchingPoi)
    ) ? 3 :
    cisdAligned and cisdContextAvailable ? 2 :
    1
)
bool cisdValid = cisdQuality >= 2
string cisdState = (
    cisdEventActive ?
    f_state_short(latestCisdDirection) + " · " +
    f_quality_text(cisdQuality) :
    "WAIT"
)
color cisdStateColor = (
    not cisdEventActive ? neutralColor :
    cisdValid ? f_state_color(latestCisdDirection) :
    warningColor
)

string liquidityState = (
    pdhSweptToday and pdlSweptToday ? "PDH + PDL SWEPT" :
    pdhSweptToday ? "PDH SWEPT" :
    pdlSweptToday ? "PDL SWEPT" :
    "PDH / PDL WAIT"
)
color liquidityStateColor = (
    pdhSweptToday and pdlSweptToday ? warningColor :
    pdhSweptToday ? bearishColor :
    pdlSweptToday ? bullishColor :
    neutralColor
)

color backgroundColor = (
    showBiasBackground and timeframeOrderValid and combinedState != 0 ?
    color.new(f_state_color(combinedState), 92) :
    na
)
bgcolor(backgroundColor, title = "Confirmed HTF bias")

var line bullishCisdCandidateLine = na
var line bearishCisdCandidateLine = na
var line confirmedCisdLine = na

if (
    showCisdLevels and
    not na(bullishCisdCandidateLevel) and
    not na(bullishCisdCandidateBar)
)
    if na(bullishCisdCandidateLine)
        bullishCisdCandidateLine := line.new(
            x1 = bullishCisdCandidateBar,
            y1 = bullishCisdCandidateLevel,
            x2 = bullishCisdCandidateBar + cisdConfirmationBars,
            y2 = bullishCisdCandidateLevel,
            xloc = xloc.bar_index,
            extend = extend.none,
            color = color.new(bullishColor, 28),
            style = line.style_dashed,
            width = 1
        )
    else
        line.set_xy1(
            bullishCisdCandidateLine,
            bullishCisdCandidateBar,
            bullishCisdCandidateLevel
        )
        line.set_xy2(
            bullishCisdCandidateLine,
            bullishCisdCandidateBar + cisdConfirmationBars,
            bullishCisdCandidateLevel
        )
else if not na(bullishCisdCandidateLine)
    line.delete(bullishCisdCandidateLine)
    bullishCisdCandidateLine := na

if (
    showCisdLevels and
    not na(bearishCisdCandidateLevel) and
    not na(bearishCisdCandidateBar)
)
    if na(bearishCisdCandidateLine)
        bearishCisdCandidateLine := line.new(
            x1 = bearishCisdCandidateBar,
            y1 = bearishCisdCandidateLevel,
            x2 = bearishCisdCandidateBar + cisdConfirmationBars,
            y2 = bearishCisdCandidateLevel,
            xloc = xloc.bar_index,
            extend = extend.none,
            color = color.new(bearishColor, 28),
            style = line.style_dashed,
            width = 1
        )
    else
        line.set_xy1(
            bearishCisdCandidateLine,
            bearishCisdCandidateBar,
            bearishCisdCandidateLevel
        )
        line.set_xy2(
            bearishCisdCandidateLine,
            bearishCisdCandidateBar + cisdConfirmationBars,
            bearishCisdCandidateLevel
        )
else if not na(bearishCisdCandidateLine)
    line.delete(bearishCisdCandidateLine)
    bearishCisdCandidateLine := na

if showCisdLevels and cisdEventPulse != 0
    if not na(confirmedCisdLine)
        line.delete(confirmedCisdLine)
    confirmedCisdLine := line.new(
        x1 = latestCisdEventBar,
        y1 = latestCisdLevel,
        x2 = latestCisdEventBar + cisdContextBars,
        y2 = latestCisdLevel,
        xloc = xloc.bar_index,
        extend = extend.none,
        color = f_state_color(latestCisdDirection),
        style = line.style_solid,
        width = 2
    )

if (
    (not showCisdLevels or not cisdEventActive) and
    not na(confirmedCisdLine)
)
    line.delete(confirmedCisdLine)
    confirmedCisdLine := na

