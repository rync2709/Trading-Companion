            text_size = size.tiny,
            text_halign = text.align_left,
            text_valign = text.align_top
        )
    else
        box.set_left(displacementCandidateBox, displacementCandidateBar)
        box.set_top(displacementCandidateBox, displacementCandidateHigh)
        box.set_right(
            displacementCandidateBox,
            displacementCandidateBar + displacementFollowThroughBars
        )
        box.set_bottom(displacementCandidateBox, displacementCandidateLow)
        box.set_border_color(
            displacementCandidateBox,
            color.new(displacementCandidateColor, 20)
        )
        box.set_bgcolor(
